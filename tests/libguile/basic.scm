;;; tests/libguile/ext-basic.c, loaded with load-extension, in real
;;; Guile and in ours: run.sh compares what each prints.  EXT_BASIC
;;; names the compiled extension.

(use-modules (rnrs bytevectors))
(load-extension (getenv "EXT_BASIC") "init_basic")

(define (show label thunk)
  (write label)
  (display " => ")
  (write (catch #t thunk (lambda (key . args) (list 'error key))))
  (newline))

(show 'sum-list (lambda () (sum-list '(1 2 3 4))))
(show 'iota-list (lambda () (iota-list 5)))
(show 'swap-pair! (lambda () (let ((p (cons 'a 'b))) (swap-pair! p) p)))
(show 'swap-shared (lambda ()
                     ;; the pair, mutated in C, is the one in the list
                     (let* ((p (cons 1 2)) (l (list p p)))
                       (swap-pair! p)
                       (list l (eq? (car l) (cadr l))))))
(show 'vector-double! (lambda () (let ((v (vector 1 2 3))) (vector-double! v) v)))
(show 'bytevector-fill-ramp! (lambda () (let ((bv (make-bytevector 6 99)))
                                          (bytevector-fill-ramp! bv)
                                          bv)))
(show 'string-info (lambda () (string-info "hello, wörld")))
(show 'call-twice (lambda () (call-twice (lambda (x) (* x 10)) 7)))
(show 'call-twice-closure (lambda ()
                            (let ((log '()))
                              (call-twice (lambda (x) (set! log (cons x log)) (+ x 1)) 0)
                              log)))
(show 'checked-sqrt (lambda () (checked-sqrt 16)))
(show 'checked-sqrt-type (lambda () (checked-sqrt "no")))
(show 'checked-sqrt-range (lambda () (checked-sqrt -1)))
(show 'optional-1 (lambda () (optional-args 1)))
(show 'optional-3 (lambda () (optional-args 1 2 3)))
(show 'rest-args (lambda () (rest-args 'a 'b 'c 'd)))
(show 'wrong-arg-count (lambda () (sum-list)))
(define c (make-counter 10))
(show 'counter (lambda () (list (counter-next! c) (counter-next! c) (counter? c) (counter? 5))))
(show 'counter-print (lambda () (object->string c)))
(show 'counter-type-error (lambda () (counter-next! 'nope)))
(show 'point (lambda () (point-coords (make-point 3 -4))))
(show 'with-cleanup (lambda () (list (with-cleanup (lambda () 'done)) (cleanups))))
(show 'with-cleanup-throw (lambda ()
                            (list (catch 'oops (lambda () (with-cleanup (lambda () (throw 'oops))))
                                    (lambda (k) k))
                                  (cleanups))))
(define (triple x) (* 3 x))
(show 'lookup-and-call (lambda () (lookup-and-call "triple" 5)))
(show 'assoc-update (lambda () (assoc-update '((a . 1) (b . 2)) 'a 10)))
(show 'hash-roundtrip (lambda () (hash-roundtrip)))
(show 'many-conses (lambda ()
                     ;; enough to make the collectors run
                     (let loop ((i 0) (sum 0))
                       (if (= i 2000)
                           sum
                           (loop (+ i 1) (+ sum (sum-list (iota-list 100))))))))
