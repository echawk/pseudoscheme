;;; IEEE 1178-1990 conformance tests, derived from the R4RS tests (r4rs.scm),
;;; which cover the examples both reports share, with what differs.


;; 4.1 Primitive expression types
(define x 28)
(test 28 x)
(test (a b c) (quote (a b c)))
(test #(a b c) '#(a b c))
(test 7 (+ 3 4))
(test 8 ((lambda (x) (+ x x)) 4))
(test (3 4 5 6) ((lambda x x) 3 4 5 6))
(test (5 6) ((lambda (x y . z) z) 3 4 5 6))
(test yes (if (> 3 2) 'yes 'no))
(test 1 (if (> 3 2) (- 3 2) (+ 3 2)))
(test 6 (let ((x 2)) (set! x 6) x))
;; 4.2 Derived expression types
(test greater (cond ((> 3 2) 'greater) ((< 3 2) 'less)))
(test equal (cond ((> 3 3) 'greater) ((< 3 3) 'less) (else 'equal)))
(test composite (case (* 2 3) ((2 3 5 7) 'prime) ((1 4 6 8 9) 'composite)))
(test consonant (case (car '(c d)) ((a e i o u) 'vowel) ((w y) 'semivowel) (else 'consonant)))
(test #t (and (= 2 2) (> 2 1)))
(test (f g) (and 1 2 'c '(f g)))
(test #t (and))
(test (b c) (or (memq 'b '(a b c)) (/ 3 0)))
(test #f (or))
(test 6 (let ((x 2) (y 3)) (* x y)))
(test 35 (let ((x 2) (y 3)) (let ((x 7) (z (+ x y))) (* z x))))
(test 70 (let ((x 2) (y 3)) (let* ((x 7) (z (+ x y))) (* z x))))
(test #t (letrec ((even? (lambda (n) (if (zero? n) #t (odd? (- n 1)))))
                  (odd? (lambda (n) (if (zero? n) #f (even? (- n 1))))))
           (even? 88)))
(test 5 (begin (define z 3) (+ z 2)))
(test #(0 1 2 3 4) (do ((vec (make-vector 5)) (i 0 (+ i 1))) ((= i 5) vec) (vector-set! vec i i)))
(test 25 (let ((x '(1 3 5 7 9))) (do ((x x (cdr x)) (sum 0 (+ sum (car x)))) ((null? x) sum))))
(test ((6 1 3) (-5 -2)) (let loop ((numbers '(3 -2 1 6 -5)) (nonneg '()) (neg '()))
  (cond ((null? numbers) (list nonneg neg))
        ((>= (car numbers) 0) (loop (cdr numbers) (cons (car numbers) nonneg) neg))
        ((< (car numbers) 0) (loop (cdr numbers) nonneg (cons (car numbers) neg))))))
(test 3 (force (delay (+ 1 2))))
(test (3 3) (let ((p (delay (+ 1 2)))) (list (force p) (force p))))
(test (list 3 4) `(list ,(+ 1 2) 4))
(test (list a (quote a)) (let ((name 'a)) `(list ,name ',name)))
(test (a 3 4 5 6 b) `(a ,(+ 1 2) ,@(map abs '(4 -5 6)) b))
(test ((foo 7) . cons) `((foo ,(- 10 3)) ,@(cdr '(c)) . ,(car '(cons))))
(test #(10 5 2 4 3 8) `#(10 5 ,(sqrt 4) ,@(map sqrt '(16 9)) 8))
;; 5 Program structure
(define add3 (lambda (x) (+ x 3)))
(test 6 (add3 3))
(define first car)
(test 1 (first '(1 2)))
(test 45 (let ((x 5))
  (define foo (lambda (y) (bar x y)))
  (define bar (lambda (a b) (+ (* a b) a)))
  (foo (+ x 3))))
(define (sq x) (* x x))
(test 16 (sq 4))
;; 6.1 Booleans: the empty list is true
(test #f (not 3))
(test #f (not '(3)))
(test #f (not '()))
(test #t (not #f))
(test #t (boolean? #f))
(test #f (boolean? 0))
(test #f (boolean? '()))
(test 1 (if '() 1 2))
;; 6.2 Equivalence
(test #t (eqv? 'a 'a))
(test #f (eqv? 'a 'b))
(test #t (eqv? 2 2))
(test #t (eqv? '() '()))
(test #f (eqv? (cons 1 2) (cons 1 2)))
(test #f (eqv? (lambda () 1) (lambda () 2)))
(test #f (eqv? #f 'nil))
(test #t (let ((p (lambda (x) x))) (eqv? p p)))
(test #t (eq? 'a 'a))
(test #t (eq? '() '()))
(test #t (equal? 'a 'a))
(test #t (equal? '(a) '(a)))
(test #t (equal? '(a (b) c) '(a (b) c)))
(test #t (equal? "abc" "abc"))
(test #t (equal? 2 2))
(test #t (equal? (make-vector 5 'a) (make-vector 5 'a)))
;; 6.3 Pairs and lists
(test #t (pair? '(a . b)))
(test #f (pair? '()))
(test #f (pair? '#(a b)))
(test (a) (cons 'a '()))
(test ((a) b c d) (cons '(a) '(b c d)))
(test (a . 3) (cons 'a 3))
(test a (car '(a b c)))
(test (b c d) (cdr '((a) b c d)))
(test 2 (cdr '(1 . 2)))
(test c (caddr '(a b c)))
(test (d) (cdddr '(a b c d)))
(test d (cadddr '(a b c d)))
(test #t (list? '(a b c)))
(test #f (list? '(a . b)))
(test (a 7 c) (list 'a (+ 3 4) 'c))
(test 3 (length '(a b c)))
(test 0 (length '()))
(test (x y) (append '(x) '(y)))
(test (a b c . d) (append '(a b) '(c . d)))
(test (c b a) (reverse '(a b c)))
(test (c d) (list-tail '(a b c d) 2))
(test c (list-ref '(a b c d) (inexact->exact (round 1.8))))
(test (a b c) (memq 'a '(a b c)))
(test (c) (memq 'c '(a b c)))
(test #f (memq 'a '(b c d)))
(test #f (memq (list 'a) '(b (a) c)))
(test ((a) c) (member (list 'a) '(b (a) c)))
(test (101 102) (memv 101 '(100 101 102)))
(test (a 1) (assq 'a '((a 1) (b 2))))
(test #f (assq 'c '((a 1) (b 2))))
(test ((a)) (assoc (list 'a) '(((a)) ((b)) ((c)))))
(test (5 7) (assv 5 '((2 3) (5 7) (11 13))))
(test (c b d) (let ((x (list 'a 'b))) (set-car! x 'c) (set-cdr! (cdr x) '(d)) x))
;; 6.4 Symbols
(test #t (symbol? 'foo))
(test #f (symbol? "bar"))
(test #t (symbol? 'nil))
(test #f (symbol? '()))
(test "flying-fish" (symbol->string 'flying-fish))
(test "martin" (symbol->string 'Martin))
(test #t (eq? 'mISSISSIppi 'mississippi))
(test #t (eq? 'bitBlt (string->symbol "bitblt")))
(test #t (eq? 'JollyWog (string->symbol (symbol->string 'JollyWog))))
;; 6.5 Numbers
(test #t (complex? 3))
(test #t (real? 3))
(test #t (rational? 6/10))
(test #t (integer? 3.0))
(test #t (exact? 3))
(test #t (inexact? 3.))
(test #t (= 1 1 1))
(test #f (< 1 3 2))
(test #t (<= 1 1 2))
(test #t (zero? 0))
(test #t (positive? 4))
(test #t (negative? -4))
(test #t (odd? 3))
(test #t (even? 0))
(test 4 (max 3 4))
(test 3 (min 3 4))
(test 7 (+ 3 4))
(test 3 (+ 3))
(test 0 (+))
(test 4 (* 4))
(test 1 (*))
(test -1 (- 3 4))
(test -3 (- 3))
(test 3/20 (/ 3 4 5))
(test 1/3 (/ 3))
(test 7 (abs -7))
(test 2 (quotient 7 3))
(test -2 (quotient -7 3))
(test 1 (remainder 7 3))
(test -1 (remainder -7 3))
(test 2 (modulo -7 3))
(test -2 (modulo 7 -3))
(test 4 (gcd 32 -36))
(test 0 (gcd))
(test 288 (lcm 32 -36))
(test 3 (numerator (/ 6 4)))
(test 2 (denominator (/ 6 4)))
(test -5. (floor -4.3))
(test -4. (ceiling -4.3))
(test -4. (truncate -4.3))
(test -4. (round -4.3))
(test 3. (floor 3.5))
(test 4. (round 3.5))
(test 4 (round 7/2))
(test 7 (round 7))
(test 1/3 (rationalize (inexact->exact .3) 1/10))
(test 1 (exp 0))
(test 0 (log 1))
(test 0 (sin 0))
(test 1 (cos 0))
(test 0 (atan 0 1))
(test 3 (sqrt 9))
(test 8 (expt 2 3))
(test 1 (expt 0 0))
(test 4 (real-part (make-rectangular 4 2)))
(test 3.0 (exact->inexact 3))
(test 3 (inexact->exact 3.0))
(test "100" (number->string 100))
(test "100" (number->string 256 16))
(test 100 (string->number "100"))
(test 256 (string->number "100" 16))
(test #f (string->number "abc"))
(test 1e2 (string->number "1e2"))
;; 6.6 Characters
(test #t (char? #\a))
(test #t (char<? #\a #\b))
(test #t (char-ci=? #\a #\A))
(test #t (char-alphabetic? #\a))
(test #t (char-numeric? #\1))
(test #t (char-whitespace? #\space))
(test #t (char-upper-case? #\A))
(test #t (char-lower-case? #\a))
(test 97 (char->integer #\a))
(test #\a (integer->char 97))
(test #\A (char-upcase #\a))
(test #\a (char-downcase #\A))
;; 6.7 Strings
(test #t (string? "a"))
(test 3 (string-length (make-string 3 #\x)))
(test "abc" (string #\a #\b #\c))
(test #\b (string-ref "abc" 1))
(test "axc" (let ((s (make-string 3 #\a))) (string-set! s 1 #\x) (string-set! s 2 #\c) s))
(test #t (string=? "abc" "abc"))
(test #t (string<? "abc" "abd"))
(test #t (string-ci=? "abc" "ABC"))
(test "bc" (substring "abcd" 1 3))
(test "abcd" (string-append "ab" "cd"))
(test "" (string-append))
(test (#\a #\b) (string->list "ab"))
(test "ab" (list->string '(#\a #\b)))
(test "abc" (string-copy "abc"))
(test "zzz" (let ((s (make-string 3 #\a))) (string-fill! s #\z) s))
;; 6.8 Vectors
(test #t (vector? #(1 2)))
(test 2 (vector-length (make-vector 2)))
(test #(a b) (vector 'a 'b))
(test 8 (vector-ref #(1 1 2 3 5 8 13 21) 5))
(test #(0 ("Sue" "Sue") "Anna") (let ((vec (vector 0 '(2 2 2 2) "Anna"))) (vector-set! vec 1 '("Sue" "Sue")) vec))
(test (dah dah didah) (vector->list '#(dah dah didah)))
(test #(dididit dah) (list->vector '(dididit dah)))
(test #(7 7) (let ((v (make-vector 2 0))) (vector-fill! v 7) v))
;; 6.9 Control features
(test #t (procedure? car))
(test #f (procedure? 'car))
(test #t (procedure? (lambda (x) (* x x))))
(test #f (procedure? '(lambda (x) (* x x))))
(test #t (call-with-current-continuation procedure?))
(test 7 (apply + (list 3 4)))
(test 10 (apply + 1 2 '(3 4)))
(test (b e h) (map cadr '((a b) (d e) (g h))))
(test (1 4 27 256 3125) (map (lambda (n) (expt n n)) '(1 2 3 4 5)))
(test (5 7 9) (map + '(1 2 3) '(4 5 6)))
(test #(0 1 4 9 16) (let ((v (make-vector 5))) (for-each (lambda (i) (vector-set! v i (* i i))) '(0 1 2 3 4)) v))
(test -3 (call-with-current-continuation (lambda (exit) (for-each (lambda (x) (if (negative? x) (exit x))) '(54 0 37 -3 245 19)) #t)))
;; 6.10 Input and output
(test #t (input-port? (current-input-port)))
(test #t (output-port? (current-output-port)))
(test #t (eof-object? (let ((p (open-input-file "/dev/null"))) (let ((c (read-char p))) (close-input-port p) c))))
(test (a b) (call-with-input-file "/dev/null" (lambda (p) '(a b))))
(test #t (procedure? char-ready?))
(test #t (procedure? peek-char))
(test #t (procedure? write-char))
;; what R4RS doesn't have
(test-error values)
(test-error (call-with-values (lambda () 1) list))
(test-error dynamic-wind)
(test-error eval)
(test-error (scheme-report-environment 5))
(test-error (define-syntax foo (syntax-rules () ((_) 1))))
(test-error (let-values (((a b) (values 1 2))) a))
(test-error (cond (#t => list)))
(test-error exact)
(test-error list-copy)
(test-error 1+)
(test-error assert)
(test-error make-promise)

(test-error with-input-from-file)
(test-error with-output-to-file)
(test-error load)
(test-error transcript-on)
(test-error transcript-off)
(test #t (procedure? peek-char))
