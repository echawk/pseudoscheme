;;; The Revised Report on Scheme (AI Memo 452, 1978): tests after its
;;; examples.  (aset' x e) is how MacLISP reads (aset x e) with x quoted.

(test 16 ((lambda (x) (* x x)) 4))
(test (a b) (quote (a b)))
(test 1 (if t 1 2))
(test 2 (if nil 1 2))
(test #t (not (if nil 1)))
(test 2 (if '() 1 2))
(define count (l)
  (labels ((countcar (lambda (l) (if (atom l) 1 (+ (countcar (car l)) (countcdr (cdr l))))))
           (countcdr (lambda (l) (if (atom l) (if (null l) 0 1) (+ (countcar (car l)) (countcdr (cdr l)))))))
    (countcdr l)))
(test 4 (count '(a (b c) d)))
(define (circulate x) (rplacd x x))
(test #t (let ((l (list 1 2))) (eq (circulate l) l)))
(define sq (lambda (x) (* x x)))
(test 9 (sq 3))
(define cube (x) (* x (sq x)))
(test 27 (cube 3))
(define y 1)
(test 44 (block (aset' y 43) (+ y 1)))
(define cons-cell
  (lambda (contents)
    (labels ((the-cell (lambda (msg)
               (if (eq msg 'contents?) contents
                   (if (eq (car msg) '<-)
                       (block (aset' contents (cadr msg)) the-cell)
                       nil)))))
      the-cell)))
(test 5 (let ((c (cons-cell 1))) (c '(<- 5)) (c 'contents?)))
;; dynamic magic
(define show () (fluid depth))
(test 2 (fluidbind ((depth 1)) (fluidbind ((depth 2)) (show))))
(test 1 (fluidbind ((depth 1)) (fluidbind ((depth 2)) 3) (show)))
(test 9 (fluidbind ((depth 1)) (fluidset' depth 9) (show)))
(test 5 (let ((x 5)) (static x)))
(test 42 (catch return (+ 1 (return 42))))
(test 3 (catch lose (amapcar (lambda (x) (if (minusp x) (lose 3) x)) '(1 -2 3))))
(test (1 2 3) (catch lose (amapcar (lambda (x) (if (minusp x) (lose 3) x)) '(1 2 3))))
;; syntactic extensions
(test 44 (block (aset' y 43) (print 'x) (+ y 1)))
(test 3 (let ((a 1) (b 2)) (+ a b)))
(test 3 (do ((i 0 (+ i 1)) (n 0 (+ n 1))) ((= i 3) n)))
(define (my-length x) (do ((z x (cdr z)) (n 0 (+ n 1))) ((null z) n)))
(test 3 (my-length '(a b c)))
(define (nrev x) (do ((a x (cdr a)) (b nil a)) ((null a) b) (rplacd a b)))
(test 6 (+ 1 2 3))
(define collate (x)
  (iterate col ((z x) (atoms nil) (lists nil))
    (if (null z)
        (list atoms lists)
        (if (atom (car z))
            (col (cdr z) (cons (car z) atoms) lists)
            (col (cdr z) atoms (cons (car z) lists))))))
(test ((c a) ((d) (b))) (collate '(a (b) c (d))))
(test 2 (test (assq 'b '((a . 1) (b . 2))) cdr 'none))
(test none (test (assq 'z '((a . 1))) cdr 'none))
(test 2 (cond ((assq 'b '((a . 1) (b . 2))) => cdr)))
(test dflt (cond ((assq 'z nil) => cdr) (t 'dflt)))
(test #t (not (cond)))
(test 7 (cond (nil 1) ((+ 3 4))))
(test 2 (cond ((null nil) 1 2)))
(test #t (not (or)))
(test #t (and))
(test 3 (or nil 3))
(test #t (not (and 1 nil 3)))
(test 3 (and 1 3))
(test (11 22 33) (amapcar + '(1 2 3) '(10 20 30)))
(test (11 22) (amapcar + '(1 2 3) '(10 20)))
(test ((1 2 3) (2 3) (3)) (amaplist (lambda (x) x) '(1 2 3)))
(test () (amapc print nil))
(test 3 (prog (i) (aset' i 0) top (if (= i 3) (return i)) (aset' i (+ i 1)) (go top)))
(test () (prog (x) (aset' x 1)))
(test 2 (prog () (go b) a (return 1) b (return 2)))
(macro my-if (p a b) (list 'cond (list p a) (list 't b)))
(test yes (my-if (null nil) 'yes 'no))
(test no (my-if (null '(1)) 'yes 'no))
(schmac swap-args (f a b) (list f b a))
(test 1 (swap-args - 1 2))
;; primitives
(test #t (procp car))
(test #t (not (procp 'car)))
(test 101 ((enclose '(lambda (z) (+ z q)) '((q . 100))) 1))
(test 3 ((enclose '(lambda (a b) (+ a b)) nil) 1 2))
(test (3 4) (let ((l (list 1 2 3 4))) (cddr l)))
(test (a b c) (list 'a 'b 'c))
(test 12.5 (*$ 2.5 5.))
(test 3 (1+ 2))
(test 1 (-1+ 2))
(test #t (zerop 0))
(test -3 (minus 3))
(test (3 2 1) (nreverse (list 1 2 3)))
(test #t (eq 'a 'a))
(test #t (equal '(a) '(a)))
(test #t (atom 'a))
(test #t (not (atom '(a))))
;; processes: coroutines
(define log nil)
(define p1 (create!process (lambda () (aset' log (cons 'p1 log)) (terminate))))
(start!process p1)
(test (p1) log)
(define p2 (create!process (lambda () (aset' log (cons 'p2a log)) (stop!process **process**) (aset' log (cons 'p2b log)) (terminate))))
(start!process p2)
(test (p2a p1) log)
(start!process p2)
(test (p2b p2a p1) log)
