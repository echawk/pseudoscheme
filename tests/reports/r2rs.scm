;;; R2RS (the Revised Revised Report, AI Memo 848, 1985) conformance
;;; tests, after the examples in the report's text.

;; II.1 Special forms
(test 7 (+ 3 4))
(test 12 ((if #!false + *) 3 4))
(test (a b c) (quote (a b c)))
(test #(a b c) '#(a b c))
(test 145932 '145932)
(test #t '#!true)
(test #t #!true)
(test #f #!false)
(test #f '#!false)
(test 8 ((lambda (x) (+ x x)) 4))
(define reverse-subtract (lambda (x y) (- y x)))
(test 3 (reverse-subtract 7 10))
(define foo (let ((x 4)) (lambda (y) (+ x y))))
(test 10 (foo 6))
(test (3 4 5 6) ((lambda x x) 3 4 5 6))
(test (5 6) ((lambda (x y . z) z) 3 4 5 6))
(test yes (if (>? 3 2) 'yes 'no))
(test no (if (>? 2 3) 'yes 'no))
(test 1 (if (>? 3 2) (- 3 2) (+ 3 2)))
(test greater (cond ((>? 3 2) 'greater) ((<? 3 2) 'less)))
(test equal (cond ((>? 3 3) 'greater) ((<? 3 3) 'less) (else 'equal)))
(test 2 (cond ((assv 'b '((a 1) (b 2))) => cadr) (else #f)))
(test composite (case (* 2 3) ((2 3 5 7) 'prime) ((1 4 6 8 9) 'composite)))
(test consonant (case (car '(c d)) ((a e i o u) 'vowel) ((y) 'y) (else 'consonant)))
(test #!true (and (=? 2 2) (>? 2 1)))
(test #!false (and (=? 2 2) (<? 2 1)))
(test (f g) (and 1 2 'c '(f g)))
(test #!true (or (=? 2 2) (>? 2 1)))
(test #!false (or #!false #!false #!false))
(test (b c) (or (memq 'b '(a b c)) (/ 3 0)))
(test 6 (let ((x 2) (y 3)) (* x y)))
(test 9 (let ((x 2) (y 3)) (let ((foo (lambda (z) (+ x y z))) (x 7)) (foo 4))))
(test 70 (let ((x 2) (y 3)) (let* ((x 7) (z (+ x y))) (* z x))))
(test 14 (letrec ((x 2) (y 3)) (letrec ((foo (lambda (z) (+ x y z))) (x 7)) (foo 4))))
(test #!true (letrec ((even? (lambda (n) (if (zero? n) #!true (odd? (-1+ n)))))
                      (odd? (lambda (n) (if (zero? n) #!false (even? (-1+ n))))))
               (even? 88)))
(test 120 ((rec fact (lambda (n) (if (zero? n) 1 (* n (fact (-1+ n)))))) 5))
(test 7 ((named-lambda (add2 x) (+ x 2)) 5))
(define add3 (lambda (x) (+ x 3)))
(test 6 (add3 3))
(define first car)
(test 1 (first '(1 2)))
(test 45 (let ((x 5))
  (define foo (lambda (y) (bar x y)))
  (define bar (lambda (a b) (+ (* a b) a)))
  (foo (+ x 3))))
(define (circ x) (* x 2))
(test 4 (circ 2))
(define ((adder a) b) (+ a b))
(test 5 ((adder 2) 3))
(define x 3)
(test 4 (begin (set! x 4) x))
(test 6 (begin (set! x 5) (1+ x)))
(test 6 (sequence (set! x 5) (1+ x)))
(test #(0 1 2 3 4) (do ((vec (make-vector 5)) (i 0 (1+ i))) ((=? i 5) vec) (vector-set! vec i i)))
(test 25 (let ((x '(1 3 5 7 9))) (do ((x x (cdr x)) (sum 0 (+ sum (car x)))) ((null? x) sum))))
(test (a 3 5 6 7 b) `(a ,(+ 1 2) ,@(map 1+ '(4 5 6)) b))
(test (((foo 7) cons)) `(((foo ,(- 10 3)) ,@(cdr '(c)) cons)))
;; II.2 Booleans: the empty list is false
(test #f (not #!true))
(test #!true (not #!false))
(test #!true (not '()))
(test #!true (not #!null))
(test #f (not 3))
(test #f (not '(3)))
(test 2 (if '() 1 2))
(test 2 (if #!null 1 2))
(test 7 (cond ((null? '(1)) 1) (else 7)))
(test () (and 1 '()))
(test 5 (or '() 5))
(test 3 (do ((i 0 (1+ i))) ((null? '()) 3)))
(test () '())
(test #!true t)
(test #!null nil)
(test (a ()) '(a #!null))
(test (1 ()) (list 1 #!null))
(test #t (null? #!null))
;; II.3 Equivalence predicates
(test #!true (eq? 'a 'a))
(test #!false (eq? 'a 'b))
(test #!false (eq? (cons 'a 'b) (cons 'a 'b)))
(test #!true (eqv? 100000 100000))
(test #!true (equal? '(a (b) c) '(a (b) c)))
(test #!true (equal? "abc" "abc"))
(test #!true (equal? (make-vector 5 'a) (make-vector 5 'a)))
;; II.4 Pairs and lists
(test #!true (pair? '(a . b)))
(test #!false (pair? '()))
(test (a) (cons 'a '()))
(test (a . 3) (cons 'a 3))
(test a (car '(a b c)))
(test (b c d) (cdr '((a) b c d)))
(test c (caddr '(a b c)))
(test (d) (cdddr '(a b c d)))
(test (a 7 c) (list 'a (+ 3 4) 'c))
(test 3 (length '(a b c)))
(test (a b c d) (append '(a b) '(c d)))
(test (a b c) (append '(a) '(b) '(c)))
(test (a b) (append! (list 'a) (list 'b)))
(test (c b a) (reverse '(a b c)))
(test c (list-ref '(a b c d) 2))
(test (c d) (list-tail '(a b c d) 2))
(test (c) (last-pair '(a b c)))
(test (b c) (memq 'b '(a b c)))
(test #!false (memq 'a '(b c d)))
(test ((a) c) (member (list 'a) '(b (a) c)))
(test (101 102) (memv 101 '(100 101 102)))
(test (b 2) (assq 'b '((a 1) (b 2))))
(test #!false (assq (list 'a) '(((a)) ((b)) ((c)))))
(test ((a)) (assoc (list 'a) '(((a)) ((b)) ((c)))))
(define l (list 'a 'b 'c))
(set-cdr! l 4)
(test (a . 4) l)
;; II.5 Symbols
(test "flying-fish" (symbol->string 'flying-fish))
(test #t (eq? 'mISSISSIppi 'mississippi))
(test #t (eq? 'bitBlt (string->symbol "bitblt")))
(test #!true (symbol? 'a))
;; II.6 Numbers
(test #t (complex? 3))
(test #t (integer? 3))
(test #t (exact? 3))
(test #t (inexact? 3.))
(test #t (zero? 0))
(test #t (=? 1 1))
(test #t (= 1 1))
(test #t (<? 1 2))
(test #t (>? 2 1))
(test #t (<=? 1 1))
(test #t (>=? 1 1))
(test 4 (max 3 4))
(test 3 (min 3 4))
(test 10 (+ 1 2 3 4))
(test 24 (* 1 2 3 4))
(test -1 (- 3 4))
(test 5 (1+ 4))
(test 3 (-1+ 4))
(test 7 (abs -7))
(test 2 (quotient 7 3))
(test 1 (remainder 7 3))
(test 2 (modulo -7 3))
(test 4 (gcd 32 -36))
(test 288 (lcm 32 -36))
(test 1 (lcm))
(test 3 (sqrt 9))
(test 8 (expt 2 3))
(test 0 (sin 0))
(test 0 (atan 0 1))
(test 1/4 (rationalize .25))
(test 3 (inexact->exact 3.0))
(test "100" (number->string 100))
(test "ff" (number->string 255 16))
(test "100" (number->string 100 '(int)))
(test 100 (string->number "100"))
(test 255 (string->number "ff" 'e 'x))
(test 255 (string->number "FF" 'exact 'hexadecimal))
(test 10. (string->number "10" 'i))
(test 5 (string->number "101" 'b))
(test #f (string->number "xyz"))
;; II.7 Characters
(test #t (char? #\a))
(test #t (char<? #\a #\b))
(test #t (char-ci=? #\a #\A))
(test #t (char-upper-case? #\A))
(test 97 (char->integer #\a))
(test #\A (char-upcase #\a))
;; II.8 Strings
(test #t (string? "a"))
(test #t (string-null? ""))
(test #f (string-null? "a"))
(test 3 (string-length (make-string 3)))
(test "bc" (substring "abcd" 1 3))
(test "abcd" (string-append "ab" "cd"))
(test (#\a #\b) (string->list "ab"))
(test "ab" (list->string '(#\a #\b)))
(test #t (string<? "abc" "abd"))
(test #t (string-ci=? "abc" "ABC"))
(test "abc" (string-copy "abc"))
(test "azzd" (let ((s (string-copy "abcd"))) (substring-fill! s 1 3 #\z) s))
(test "xyzd" (let ((s (string-copy "abcd"))) (substring-move-left! "xyz" 0 3 s 0) s))
(test "xyzd" (let ((s (string-copy "abcd"))) (substring-move-right! "xyz" 0 3 s 0) s))
(test "abab" (let ((s (string-copy "abcd"))) (substring-move-left! s 0 2 s 2) s))
(test "aabc" (let ((s (string-copy "abcd"))) (substring-move-right! s 0 3 s 1) s))
;; II.9, II.10 Vectors and the object table
(test 8 (vector-ref '#(1 1 2 3 5 8 13 21) 5))
(test #(7 7) (let ((v (make-vector 2 0))) (vector-fill! v 7) v))
(test (dah dah) (vector->list '#(dah dah)))
(test #(a b) (list->vector '(a b)))
(define key (cons 1 2))
(test #t (let ((n (object-hash key))) (and (eq? n (object-hash key)) (eq? key (object-unhash n)))))
(test #f (object-unhash 12345))
;; II.11 Procedures
(test 7 (apply + (list 3 4)))
(test 10 (apply + 1 2 '(3 4)))
(test (b e h) (map cadr '((a b) (d e) (g h))))
(test (5 7 9) (map + '(1 2 3) '(4 5 6)))
(test -3 (call-with-current-continuation (lambda (exit) (for-each (lambda (x) (if (negative? x) (exit x))) '(54 0 37 -3 245 19)) #t)))
;; II.12-14 Ports and I/O
(test #t (input-port? (current-input-port)))
(test #t (output-port? (current-output-port)))
(test #t (eof-object? (call-with-input-file "/dev/null" read-char)))
(test 1 (begin (transcript-off) 1))
(test #t (eof-object? (call-with-input-file "/dev/null" (lambda (p) (char-ready? p) (read-char p)))))
;; what R2RS doesn't have
(test-error values)
(test-error dynamic-wind)
(test-error (delay 1))
(test-error force)
(test-error procedure?)
(test-error boolean?)
(test-error list?)
(test-error peek-char)
(test-error numerator)
(test-error list-copy)
(test-error (define-syntax foo (syntax-rules () ((_) 1))))
(test-error string)
(test-error eval)
