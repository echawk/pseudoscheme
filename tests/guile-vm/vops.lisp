;;; The :vop backend's VOPs (src/guile/vm-vops.lisp) against Lisp's own
;;; arithmetic, open-coded and called, on edge cases and random values.
;;; Usage: sbcl --script tests/guile-vm/vops.lisp
(require :asdf)
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (probe-file setup) (load setup)))
(push (merge-pathnames "../../" (make-pathname :name nil :type nil :defaults *load-truename*))
      asdf:*central-registry*)
(handler-bind ((warning #'muffle-warning)) (asdf:load-system :quasischeme/guile))
(in-package "QUASISCHEME-GUILE")
(unless *vm-vops*
  (format t "no VOPs here (SBCL on arm64 only)~%")
  (sb-ext:exit))
(defun fix (r) (and (typep r 'fixnum) r))
(defun fx (&rest xs) (every (lambda (x) (typep x 'fixnum)) xs))
(defun ux (&rest xs) (every (lambda (x) (typep x '(and fixnum unsigned-byte))) xs))
(defparameter *specs*
  `((%vm-fixnum+ ,(lambda (x y) (and (fx x y) (fix (+ x y)))))
    (%vm-fixnum- ,(lambda (x y) (and (fx x y) (fix (- x y)))))
    (%vm-fixnum* ,(lambda (x y) (and (fx x y) (fix (* x y)))))
    (%vm-fixnum-quotient ,(lambda (x y) (and (fx x y) (not (member y '(0 -1))) (truncate x y))))
    (%vm-fixnum-remainder ,(lambda (x y) (and (fx x y) (not (member y '(0 -1))) (rem x y))))
    (%vm-fixnum-modulo ,(lambda (x y) (and (fx x y) (not (member y '(0 -1))) (mod x y))))
    (%vm-fixnum-logand ,(lambda (x y) (and (fx x y) (logand x y))))
    (%vm-fixnum-logior ,(lambda (x y) (and (fx x y) (logior x y))))
    (%vm-fixnum-logxor ,(lambda (x y) (and (fx x y) (logxor x y))))
    (%vm-fixnum-logsub ,(lambda (x y) (and (fx x y) (logandc2 x y))))
    (%vm-fixnum-ash-left ,(lambda (x n) (and (fx x n) (<= 0 n 63) (fix (ash x n)))))
    (%vm-fixnum-ash-right ,(lambda (x n) (and (fx x n) (>= n 0) (ash x (- (min n 63))))))
    (%vm-u64+ ,(lambda (x y) (and (ux x y) (fix (+ x y)))))
    (%vm-u64- ,(lambda (x y) (and (ux x y) (>= x y) (- x y))))
    (%vm-u64* ,(lambda (x y) (and (ux x y) (fix (* x y)))))
    (%vm-u64-logand ,(lambda (x y) (and (ux x y) (logand x y))))
    (%vm-u64-logior ,(lambda (x y) (and (ux x y) (logior x y))))
    (%vm-u64-logxor ,(lambda (x y) (and (ux x y) (logxor x y))))
    (%vm-u64-logsub ,(lambda (x y) (and (ux x y) (logandc2 x y))))
    (%vm-u64-lsh ,(lambda (x n) (and (ux x n) (fix (ash x (logand n 63))))))
    (%vm-u64-rsh ,(lambda (x n) (and (ux x n) (ash x (- (logand n 63))))))
    (%vm-fixnums-p ,(lambda (x y) (fx x y)))
    (%vm-u64s-p ,(lambda (x y) (ux x y)))
    (%vm-u64-p ,(lambda (x) (ux x)))
    (%vm-guile-fixnum-p ,(lambda (x) (typep x '(signed-byte 62))))
    (%vm-vector-word-p ,(lambda (x i) (and (simple-vector-p x) (fx i) (<= 1 i (length x)))))))
;; open-coded versions
(defmacro open-coded ()
  `(list ,@(loop for (name) in *specs*
		 collect (let ((n (if (member name '(%vm-u64-p %vm-guile-fixnum-p)) 1 2)))
			   (if (= n 1)
			       `(cons ',name (lambda (x) (declare (optimize speed (safety 0))) (if (,name x) t nil)))
			       (if (search "-P" (symbol-name name))
				   `(cons ',name (lambda (x y) (declare (optimize speed (safety 0))) (if (,name x y) t nil)))
				   `(cons ',name (lambda (x y) (declare (optimize speed (safety 0))) (,name x y)))))))))
(defparameter *open* (open-coded))
(defparameter *values*
  (let ((m most-positive-fixnum) (n most-negative-fixnum))
    (append (list 0 1 -1 2 -2 3 7 63 64 62 61 100 -100 m n (1- m) (1+ n) (floor m 2) (floor n 2) (1+ m) (1- n)
		  (ash 1 61) (- (ash 1 61)) (1- (ash 1 61)) (ash 1 62) (ash 1 31) (1- (ash 1 32)) (ash 1 64)
		  1.5d0 nil t #\a '(1 2) (vector 1 2 3) (vector) "abc" (make-array 3 :element-type 'fixnum))
	    (loop repeat 60 collect (- (random (ash 1 63)) (ash 1 62)))
	    (loop repeat 30 collect (random 70))
	    (loop repeat 30 collect (- (random 2000) 1000)))))
(let ((fails 0) (tests 0))
  (dolist (spec *specs*)
    (destructuring-bind (name ref) spec
      (let ((f (cdr (assoc name *open*))) (arity (if (member name '(%vm-u64-p %vm-guile-fixnum-p)) 1 2)))
	(dolist (x *values*)
	  (dolist (y (if (= arity 1) '(nil) *values*))
	    (incf tests)
	    (let ((want (if (= arity 1) (funcall ref x) (funcall ref x y)))
		  (got (if (= arity 1) (funcall f x) (funcall f x y)))
		  (called (if (= arity 1) (funcall name x) (funcall name x y))))
	      (when (search "-P" (symbol-name name)) (setq want (and want t) called (and called t)))
	      (unless (and (eql want got) (eql want called))
		(incf fails)
		(when (< fails 30) (format t "~&FAIL ~A ~S ~S: want ~S got ~S called ~S~%" name x y want got called)))))))))
  (format t "~&~D tests, ~D failures~%" tests fails)
  (sb-ext:exit :code (if (zerop fails) 0 1)))
