#lang racket/base
;; Control (call/cc re-entered, dynamic-wind, raise, parameterize),
;; for loops, keyword and optional arguments, match, racket/list,
;; structs (mutable, applicable), hashes, ports
(require racket/list racket/match)
(define (show . xs) (for-each (lambda (x) (write x) (display " ")) xs) (newline))
(define-syntax-rule (try e) e)
(try (show (call/cc (lambda (k) (+ 1 (k 42)))) (let ([k2 #f] [n 0]) (call/cc (lambda (k) (set! k2 k))) (set! n (add1 n)) (if (< n 3) (k2 #f) n))))
(try (show (let ([l '()]) (dynamic-wind (lambda () (set! l (cons 'in l))) (lambda () (set! l (cons 'body l))) (lambda () (set! l (cons 'out l)))) (reverse l))))
(try (show (with-handlers ([symbol? (lambda (s) (list 'caught s))]) (raise 'oops))))
(try (show (let ([p (make-parameter 1)]) (list (p) (parameterize ([p 2]) (p)) (p)))))
(try (show (for*/list ([i 2] [j 2]) (list i j)) (for/list ([(k v) (in-hash (hasheq 'a 1))]) (cons k v)) (for/list ([i (in-naturals)] [x '(a b)]) (cons i x))))
(try (show (let-values ([(a b) (values 1 2)] [(c) (values 3)]) (list a b c))))
(define-values (dv1 dv2) (values 'x 'y))
(try (show dv1 dv2))
(define (kw a #:b [b 10] . rest) (list a b rest))
(try (show (kw 1) (kw 1 #:b 2) (kw 1 2 3) (keyword-apply kw '(#:b) '(5) '(0))))
(define (opt a [b (* a 2)]) (list a b))
(try (show (opt 1) (opt 1 5)))
(try (show (match '(1 (2 3)) [(list a (list b c)) (+ a b c)]) (match 5 [(? even?) 'even] [_ 'odd]) (match '(1 2 3) [(cons h t) t])))
(try (show (first '(1 2)) (last '(1 2 3)) (take '(1 2 3) 2) (drop '(1 2 3) 2) (flatten '(1 (2 (3)))) (remove-duplicates '(1 2 1)) (range 4) (append* '((1) (2)))))
(try (show (argmin abs '(-3 1 2)) (count even? '(1 2 4)) (call-with-values (lambda () (partition even? '(1 2 3 4))) list) (assf even? '((1 . a) (2 . b)))))
(struct animal (name [sound #:mutable]) #:transparent)
(try (let ([a (animal "cat" "meow")]) (set-animal-sound! a "purr") (show a (animal-sound a) (animal? a) (animal? 5))))
(struct circle (r) #:property prop:procedure (lambda (self x) (* x (circle-r self))))
(try (show ((circle 3) 2)))
(try (show (string->list "ab") (list->vector '(1 2)) (vector-length (make-vector 3)) (string-ref "abc" 1) (substring "hello" 1 3)))
(try (show (exact->inexact 2/3) (inexact->exact 0.5) (exact? 1/2) (integer? 2.0) (number->string 3.0) (round 2.5) (truncate 2.7)))
(try (show (let ([h (make-hash)]) (hash-set! h 'a 1) (hash-update! h 'a add1) (hash-ref h 'a)) (hash-keys (hash 'a 1)) (hash-has-key? (hash 'a 1) 'b)))
(try (show (equal? (make-vector 2 0) (vector 0 0)) (eq? 'a 'a) (eqv? 1.0 1.0) (equal? "a" "a") (eq? (list 1) (list 1))))
(try (show (andmap even? '(2 4)) (ormap even? '(1 3)) (foldl cons '() '(1 2)) (foldr cons '() '(1 2)) (map + '(1 2) '(10 20))))
(try (show (string? "a") (symbol? 'a) (char? #\a) (boolean? #f) (null? '()) (pair? '(1)) (vector? #(1)) (hash? (hash)) (box? (box 1)) (unbox (box 5))))
(try (show (let ([o (open-output-string)]) (write 'sym o) (display " " o) (fprintf o "~a" 42) (get-output-string o)) (read (open-input-string "(a . b)")) (read-line (open-input-string "l1\nl2"))))
(try (show (exn:fail:contract? (with-handlers ([values values]) (vector-ref (vector) 0))) (exn:fail:contract:divide-by-zero? (with-handlers ([values values]) (quotient 1 0)))))
(try (show (let-values ([(r c real gc) (time-apply (lambda () 1) (list))]) r)))
