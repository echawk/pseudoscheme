#lang racket/base
;; kill, break, mailboxes, suspend/resume, custodians
(define t (thread (lambda () (let loop () (sleep 0.001) (loop)))))
(kill-thread t)
(displayln (list (thread-dead? t) (thread-running? t)))
(define b (thread (lambda () (with-handlers ([exn:break? (lambda (e) (displayln (exn-message e)))]) (sleep 10)))))
(sleep 0.02)
(break-thread b)
(thread-wait b)
(define m (thread (lambda () (displayln (list (thread-receive) (thread-receive) (thread-try-receive))))))
(thread-send m 1)
(thread-send m 2)
(thread-wait m)
(displayln (thread-send m 3 (lambda () 'dead)))
(define c (thread (lambda () (let loop ([n 0]) (sleep 0.001) (loop (add1 n))))))
(thread-suspend c)
(displayln (list (thread-running? c) (thread-dead? c)))
(thread-resume c)
(displayln (list (thread-running? c) (thread-dead? c)))
(kill-thread c)
(define cust (make-custodian))
(define ct (parameterize ([current-custodian cust]) (thread (lambda () (sleep 100)))))
(displayln (list (custodian? cust) (custodian-shut-down? cust) (thread-dead? ct)
                 (length (custodian-managed-list cust (current-custodian)))))
(custodian-shutdown-all cust)
(thread-wait ct)
(displayln (list (custodian-shut-down? cust) (thread-dead? ct)))
(define cb (make-custodian-box (make-custodian) 'v))
(displayln (custodian-box-value cb))
(displayln (call-in-nested-thread (lambda () (+ 1 2))))
(thread-send (current-thread) 'self)
(thread-rewind-receive '(a b))
(displayln (list (thread-receive) (thread-receive) (thread-receive)))
