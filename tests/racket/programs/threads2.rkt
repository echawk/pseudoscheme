#lang racket/base
;; sync: choice, wrap, handle, timeout, alarm, nack
(define s1 (make-semaphore 1))
(displayln (sync (wrap-evt s1 (lambda (x) (list 'wrapped (semaphore? x))))))
(displayln (sync/timeout 0 s1))
(displayln (sync/timeout 0.01 (make-semaphore)))
(displayln (sync/timeout (lambda () 'thunk) never-evt))
(displayln (sync (handle-evt always-evt (lambda (x) 'handled))))
(displayln (sync (choice-evt (wrap-evt never-evt (lambda (x) 1)) (wrap-evt always-evt (lambda (x) 2)))))
(define t0 (current-inexact-milliseconds))
(displayln (evt? (sync (alarm-evt (+ t0 30)))))
(displayln (>= (- (current-inexact-milliseconds) t0) 29))
(define nack #f)
(define g (nack-guard-evt (lambda (n) (set! nack n) never-evt)))
(displayln (sync (choice-evt g always-evt)) )
(displayln (and (sync/timeout 0 nack) #t))
(displayln (sync (guard-evt (lambda () (wrap-evt always-evt (lambda (_) 'guarded))))))
(displayln (sync (poll-guard-evt (lambda (poll?) (wrap-evt always-evt (lambda (_) poll?))))))
(displayln (sync/timeout 0 (poll-guard-evt (lambda (poll?) (wrap-evt always-evt (lambda (_) poll?))))))
(struct ev (s) #:property prop:evt (lambda (self) (ev-s self)))
(displayln (evt? (ev (make-semaphore 1))))
(displayln (semaphore? (sync (ev (make-semaphore 1)))))
(define ch (make-channel))
(void (thread (lambda () (channel-put ch 'hello))))
(displayln (sync ch))
(displayln (sync/timeout 0 (channel-put-evt ch 1)))
(define pe (channel-put-evt ch 'x))
(void (thread (lambda () (displayln (channel-get ch)))))
(displayln (eq? pe (sync pe)))
(sleep 0.01)
