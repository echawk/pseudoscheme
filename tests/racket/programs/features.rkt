#lang racket/base
;; More of racket/base: folds, hashes, continuations, parameters, string
;; ports, mutable structs, case, floats as Racket prints them.
(define (show . xs) (for-each (lambda (x) (write x) (display " ")) xs) (newline))
(show (for/fold ([acc 0]) ([i (in-range 5)]) (+ acc i))
      (hash-ref (for/hash ([k '(a b)] [v '(1 2)]) (values k v)) 'b)
      (for/vector ([i 3]) (* i i)))
(define h (make-hash))
(hash-update! h 'x add1 0)
(hash-update! h 'x add1 0)
(show (hash-ref h 'x) (sort '(3 1 2) <) (sort '("b" "a") string<?))
(show (case 3 [(1 2) 'low] [(3 4) 'mid] [else 'high])
      (cond [(assv 2 '((1 . a) (2 . b))) => cdr] [else #f]))
(show 1.5 0.1 -0.0 1e21 1e-7 (/ 1 3) (exact->inexact 1/3) (sqrt -4) (expt 2 100))
(show (number->string 255 16) (string->number "1e3") (string->number "#xff"))
(define p (make-parameter 1))
(show (parameterize ([p 2]) (p)) (p))
(show (call-with-current-continuation (lambda (k) (+ 1 (k 42)))))
(show (let ([trail '()])
        (dynamic-wind (lambda () (set! trail (cons 'in trail)))
                      (lambda () 'body)
                      (lambda () (set! trail (cons 'out trail))))
        (reverse trail)))
(show (let ([o (open-output-string)]) (write '(a "b" #\c) o) (get-output-string o))
      (read (open-input-string "(1 (2 . 3) #(4))")))
(struct counter ([n #:mutable]))
(define c (counter 0))
(set-counter-n! c 5)
(show (counter-n c))
(show (with-handlers ([string? (lambda (s) (string-append "caught " s))]) (raise "it"))
      (with-handlers ([exn:fail:contract:divide-by-zero? (lambda (e) 'div0)]) (/ 1 0)))
(show (apply + 1 2 '(3 4)) (keyword-apply (lambda (#:k k x) (list k x)) '(#:k) '(1) '(2)))
(show (apply string-append "a" '("b" "c")) (list->string (list #\a #\b)) (string->list "hi"))
(show (vector->list #(1 2)) (vector->list (make-vector 2 'x)) (build-list 3 values))
(show (inexact->exact (round 2.5)) (inexact->exact (floor 2.7)) (truncate -2.5) (round 3.5) (quotient 7 2) (modulo -7 2))
