#lang racket/base
;; parameterize inheritance and thread cells
(define p (make-parameter 'root))
(define tc (make-thread-cell 'init #f))
(define tp (make-thread-cell 'init #t))
(thread-cell-set! tc 'main)
(thread-cell-set! tp 'main)
(define result (make-channel))
(void (parameterize ([p 'inner])
  (thread (lambda ()
            (channel-put result (list (p) (thread-cell-ref tc) (thread-cell-ref tp)))))))
(displayln (channel-get result))
(void (thread (lambda () (p 'changed) (thread-cell-set! tp 'child) (channel-put result (list (p) (thread-cell-ref tp))))))
(displayln (channel-get result))
(displayln (list (p) (thread-cell-ref tp)))
(define out (open-output-string))
(thread-wait (parameterize ([current-output-port out]) (thread (lambda () (display "from thread")))))
(displayln (get-output-string out))
(displayln (call-in-nested-thread (lambda () (p))))
(current-error-port (current-output-port))
(define t (thread (lambda () (error "boom in thread"))))
(thread-wait t)
(displayln "main continues")
(define we (make-will-executor))
(displayln (will-try-execute we 'none))
(displayln (list (plumber? (current-plumber)) (security-guard? (current-security-guard)) (thread-group? (current-thread-group))))
(displayln (list (exn-classify-errno (cons 2 'posix)) (exn-classify-errno (cons 17 'posix))))
