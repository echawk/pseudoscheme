#lang racket/base
;; Common racket/base (and racket/string) operations, as Racket prints them
(require racket/string)
(define (show . xs) (for-each (lambda (x) (write x) (display " ")) xs) (newline))
(show (sort '(3 1 2) <) (sort '("b" "a") string<?) (sort '((b . 2) (a . 1)) < #:key cdr))
(show (for/list ([i 3] [c "abc"]) (cons i c)) (for/vector ([i 3]) (* i i)) (for/hash ([i 2]) (values i (add1 i))))
(show (for/sum ([i 4]) i) (for/and ([i '(1 2)]) (odd? i)) (for/first ([i '(1 2 3)] #:when (even? i)) i))
(show (string-upcase "abc") (string-append* "a" '("b" "c")) (number->string 255 16) (string->number "#xff"))
(show (exact->inexact 1/3) (/ 1 3) (sqrt -4) (expt 2 100))
(show (assoc 2 '((1 . a) (2 . b))) (member 2 '(1 2 3)) (remove 2 '(1 2 3 2)) (filter even? '(1 2 3 4)))
(show (hash-ref (hash 'a 1) 'a) (hash-ref (hash) 'b 'none) (hash-count (make-hash '((a . 1)))))
(show (let-values ([(q r) (quotient/remainder 7 2)]) (list q r)) (call-with-values (lambda () (values 1 2)) list))
(show (with-handlers ([exn:fail? exn-message]) (error 'foo "bad ~a" 1)))
(show (with-handlers ([exn:fail? exn-message]) (raise-argument-error 'f "string?" 5)))
(show (format "~a ~s ~v" "x" "x" 'y) (format "~e" 1.5))
(show (char-upcase #\a) (char->integer #\λ) (string #\a #\b) (list->string (map char-upcase (string->list "hi"))))
(struct pt (x y) #:transparent)
(show (pt 1 2) (equal? (pt 1 2) (pt 1 2)) (pt-x (pt 1 2)) (struct->vector (pt 1 2)))
(show (regexp-match #rx"a(b+)" "xabbby") (regexp-replace* #rx"o" "foo" "0") (regexp-split #rx"," "a,b,c"))
(show (build-vector 3 values) (vector->list #(1 2)))
(show (apply max '(3 7 2)) (min 1 2.0) (abs -5) (gcd 12 18) (lcm 4 6))
(show (symbol->string 'abc) (string->symbol "x y") (keyword->string '#:k))
(show (void) (void? (void)) (eof-object? eof) (procedure? car))
(show (let loop ([i 0] [acc '()]) (if (= i 3) (reverse acc) (loop (add1 i) (cons i acc)))))
(show (case 3 [(1 2) 'low] [(3 4) 'mid] [else 'high]) (cond [(assv 2 '((2 . x))) => cdr] [else #f]))
(show (string-split "a b  c") (string-join '("a" "b") ",") (string-trim "  x  ") (string-prefix? "abc" "ab"))
(show (exact->inexact 100) 1e21 123456789012.5 -0.0 +inf.0 (/ 0.0 0.0))
