#lang racket/base
;; TCP and UDP on the loopback interface (src/racket/native/network.lisp).
;; Ephemeral port numbers are shown as booleans.  The .expected file is
;; what Racket 9.3 prints.
(require '#%network)
(define (try th) (with-handlers ([exn? (lambda (e) (list (exn-message e)))]) (call-with-values th list)))
;; the first line of the message only: the system's error differs
(define (try1 th)
  (with-handlers ([exn? (lambda (e) (list (car (regexp-split #rx"\n" (exn-message e)))))])
    (call-with-values th list)))

;; TCP
(define l (tcp-listen 0 4 #t "127.0.0.1"))
(define-values (la lp pa pp) (tcp-addresses l #t))
(displayln (list la (> lp 0) pa pp (tcp-listener? l) (tcp-port? l) (tcp-accept-ready? l)))
(define-values (i o) (tcp-connect "127.0.0.1" lp))
(displayln (list (tcp-port? i) (tcp-port? o) (input-port? i) (output-port? o) (tcp-accept-ready? l)))
(define-values (i2 o2) (tcp-accept l))
(write-bytes #"hello\nworld\n" o) (flush-output o)
(displayln (list (read-line i2) (peek-bytes 3 0 i2) (read-bytes 6 i2)))
(let-values ([(a b c d) (tcp-addresses o #t)]) (displayln (list a (> b 0) c (= d lp))))
(close-output-port o)
(displayln (list (read-bytes 5 i2) (eof-object? (read-byte i2)) (port-closed? o) (port-closed? i)))
(write-string "back" o2) (close-output-port o2)
(displayln (read-string 10 i))
(close-input-port i) (close-input-port i2)
(displayln (try (lambda () (tcp-addresses i))))
(tcp-close l)
(displayln (try (lambda () (tcp-close l))))
(displayln (try (lambda () (tcp-accept 5))))
(displayln (try (lambda () (tcp-connect "127.0.0.1" 0))))
(displayln (try (lambda () (tcp-listen 70000))))
(displayln (try1 (lambda () (tcp-connect "nohost.invalid" 80))))
(define e (tcp-accept-evt (tcp-listen 0 4 #t "127.0.0.1")))
(displayln (sync/timeout 0 e))

;; UDP
(define a (udp-open-socket)) (define b (udp-open-socket "127.0.0.1" 1))
(udp-bind! a "127.0.0.1" 0) (udp-bind! b "127.0.0.1" 0)
(define (port u) (let-values ([(h p x y) (tcp-addresses u #t)]) p))
(displayln (list (udp? a) (udp-bound? a) (udp-connected? a) (try (lambda () (udp-bind! a "127.0.0.1" 0)))))
(udp-send-to a "127.0.0.1" (port b) #"hello world" 6)
(define buf (make-bytes 8 46))
(let-values ([(n h p) (udp-receive! b buf)]) (displayln (list n h (= p (port a)) buf)))
(let-values ([(n h p) (udp-receive!* b buf)]) (displayln (list n h p)))
(udp-connect! a "127.0.0.1" (port b))
(displayln (list (udp-connected? a) (try (lambda () (udp-send-to a "127.0.0.1" 9 #"x")))))
(displayln (udp-send* a #"abc"))
(displayln (let ([r (sync/timeout 1 (udp-receive!-evt b buf 1 3))]) (list (car r) (cadr r))))
(displayln buf)
(udp-connect! a #f #f)
(displayln (list (udp-connected? a) (try (lambda () (udp-send a #"x")))))
(displayln (try (lambda () (udp-send-to a "127.0.0.1" 9 #"abc" 2 9))))
(displayln (try (lambda () (udp-receive! (udp-open-socket) buf))))
(displayln (try1 (lambda () (udp-send-to a "nohost.invalid" 9 #"abc"))))
(udp-set-ttl! a 9) (displayln (list (udp-ttl a) (try (lambda () (udp-set-ttl! a 300)))))
(displayln (list (udp-multicast-ttl a) (udp-multicast-loopback? a) (udp-multicast-interface a)))
(udp-close a)
(displayln (try (lambda () (udp-close a))))
(displayln (try (lambda () (udp-send-to a "127.0.0.1" 9 #"x"))))
(displayln (try (lambda () (udp-bound? 5))))
(displayln (sync/timeout 0 (udp-send-ready-evt b)))
