#lang racket/base
;; The C interface: calls into libc, memory, cstructs, callbacks, errno
;; and the errors of #%foreign (src/racket/native/foreign.lisp).  The
;; .expected file is what Racket 9.3 prints.
(require racket/flonum ffi/unsafe (only-in '#%foreign ffi-obj))
(define (try th) (with-handlers ([(lambda (e) #t) (lambda (e) (if (exn? e) (exn-message e) e))]) (th)))
(define libc (ffi-lib #f))
(define strlen (get-ffi-obj "strlen" libc (_fun _bytes -> _long)))
(define abs* (get-ffi-obj "abs" libc (_fun _int -> _int)))
(displayln (list (strlen #"hello") (abs* -42)))
(define p (malloc 16 'raw))
(ptr-set! p _int32 0 7) (ptr-set! p _int32 1 -9) (ptr-set! p _double 'abs 8 2.5)
(displayln (list (ptr-ref p _int32 0) (ptr-ref p _int32 1) (ptr-ref p _double 'abs 8) (ptr-ref p _uint8 'abs 4)))
(free p)
(define-cstruct _pt ([x _int32] [y _double] [z _int8]))
(define s (make-pt 5 1.5 -3))
(displayln (list (pt-x s) (pt-y s) (pt-z s) (ctype-sizeof _pt) (ctype-alignof _pt)))
(define cmp (_fun _pointer _pointer -> _int))
(define qsort (get-ffi-obj "qsort" libc (_fun _pointer _size _size (_fun _pointer _pointer -> _int) -> _void)))
(define arr (malloc 5 _int32 'raw))
(for ([i 5] [v '(5 3 9 1 7)]) (ptr-set! arr _int32 i v))
(qsort arr 5 4 (lambda (a b) (- (ptr-ref a _int32) (ptr-ref b _int32))))
(displayln (for/list ([i 5]) (ptr-ref arr _int32 i)))
(define open (get-ffi-obj "open" libc (_fun #:save-errno 'posix _path _int -> _int)))
(displayln (open "/nonexistent/x" 0))
(displayln (= (saved-errno) (lookup-errno 'ENOENT)))
(define b (make-bytes 8 0))
(ptr-set! b _int16 1 258)
(displayln (bytes->list b))
(displayln (list (ptr-ref (ptr-add b 2) _uint8) (ptr-offset (ptr-add b 3)) (ptr-equal? (ptr-add b 2) (ptr-add b 2))))
(define m (malloc 8))
(ptr-set! m _string/utf-16 'abs 0 "hi")
(displayln (cpointer? m))
(define sp (malloc 8 'raw))
(ptr-set! sp _bytes #"xyz\0")
(displayln (ptr-ref sp _bytes))
(displayln (ptr-ref (malloc 8 'raw) _pointer))
(define cb (function-ptr (lambda (x) (+ x 1)) (_fun _int -> _int)))
(displayln ((cast cb _pointer (_fun _int -> _int)) 41))
(displayln (list (ctype-sizeof _bool) (compiler-sizeof 'int) (compiler-sizeof '(long long)) (compiler-sizeof '(int *))))

;; errors
(define q (malloc 16 'raw))
(displayln (try (lambda () (ptr-set! q _int8 200))))
(displayln (try (lambda () (ptr-set! q _bytes 5))))
(displayln (try (lambda () (ptr-set! q _float 'a))))
(displayln (try (lambda () (ptr-set! q _string/utf-16 5))))
(displayln (try (lambda () (ptr-ref q _void))))
(displayln (try (lambda () (ptr-set! q _void 1))))
(displayln (try (lambda () (ptr-ref 5 _int8))))
(displayln (try (lambda () (ptr-ref q 5))))
(displayln (try (lambda () (ptr-ref q _int8 'x 5))))
(displayln (try (lambda () (ptr-ref q _int8 1.5))))
(displayln (try (lambda () (malloc 'x))))
(displayln (try (lambda () (malloc))))
(displayln (try (lambda () (malloc 4 4))))
(displayln (try (lambda () (malloc 4 'tagged))))
(define strlen-int (get-ffi-obj "strlen" #f (_fun _bytes -> _int)))
(displayln (try (lambda () (strlen-int 5))))
(displayln (try (lambda () (strlen-int #"hello"))))
(displayln (try (lambda () (set-cpointer-tag! 5 1))))
(displayln (try (lambda () (cpointer-tag 5))))
(displayln (try (lambda () (ptr-add 5 1))))
(displayln (try (lambda () (vector->cpointer (vector 1)))))
(displayln (try (lambda () (flvector->cpointer (make-flvector 2)))))
(displayln (try (lambda () (make-sized-byte-string q 4))))
(displayln (try (lambda () (end-stubborn-change q))))
(displayln (try (lambda () (lookup-errno 'ENOENT))))
(displayln (try (lambda () (lookup-errno 'EDOM))))
(displayln (try (lambda () (lookup-errno 'nonesuch))))
(displayln (try (lambda () (ctype-sizeof 5))))
(displayln (try (lambda () (make-array-type _int8 -1))))
(displayln (try (lambda () (compiler-sizeof 'foo))))
(displayln (try (lambda () (compiler-sizeof '(long long)))))
(displayln (try (lambda () (compiler-sizeof 'void))))
(displayln (try (lambda () (memcpy q 5 3))))
(displayln (try (lambda () (memset q 300 3))))
(displayln (try (lambda () (offset-ptr? 5))))
(displayln (try (lambda () (ptr-offset 5))))
(displayln (try (lambda () (set-ptr-offset! q 5))))
(displayln (try (lambda () (free 5))))
(displayln (try (lambda () (ptr-equal? 5 q))))
(displayln (try (lambda () (make-ctype 5 #f #f))))
(displayln (try (lambda () (ptr-ref (ptr-add q 8) _int8 'abs 2.5))))

