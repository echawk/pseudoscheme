;; QUASISCHEME: the R7RS names the benchmarks use, in R5RS (--r5rs has
;; exactly R5RS's names).  R5RS has no clock: the jiffies are 0, and
;; bench's quasischeme_r5rs_exec times the whole run from outside.
;; Benchmarks needing more (bytevectors, values forms, string ports)
;; crash.
(define-syntax import
  (syntax-rules ()
    ((import . stuff) (begin))))
(define-syntax when
  (syntax-rules ()
    ((when c e ...) (if c (begin e ...)))))
(define-syntax unless
  (syntax-rules ()
    ((unless c e ...) (if c #f (begin e ...)))))
(define (current-jiffy) 0)
(define (jiffies-per-second) 1)
(define (current-second) 0)
(define (flush-output-port . port) #f)
(define exact inexact->exact)
(define inexact exact->inexact)
(define (square x) (* x x))
(define (exact-integer? x) (and (integer? x) (exact? x)))
(define (write-string s . port) (apply display s port))
(define (error msg . irritants)
  (display "Error: ") (display msg)
  (for-each (lambda (x) (display " ") (write x)) irritants)
  (newline)
  (vector-ref (vector) 0))
(define (read-line . port)
  (let loop ((cs '()))
    (let ((c (apply read-char port)))
      (cond ((eof-object? c) (if (null? cs) c (list->string (reverse cs))))
            ((char=? c #\newline) (list->string (reverse cs)))
            (else (loop (cons c cs)))))))
(define (list-copy l) (if (pair? l) (cons (car l) (list-copy (cdr l))) l))
(define (string-for-each f s . ss)
  (apply for-each f (string->list s) (map string->list ss)))
(define (string-map f s . ss)
  (list->string (apply map f (string->list s) (map string->list ss))))
(define (vector-map f v . vs)
  (list->vector (apply map f (vector->list v) (map vector->list vs))))
(define (vector-for-each f v . vs)
  (apply for-each f (vector->list v) (map vector->list vs)))
(define (exact-integer-sqrt n)
  (let ((s (inexact->exact (floor (sqrt n)))))
    (values s (- n (* s s)))))
(define (truncate-quotient n d) (quotient n d))
(define (truncate-remainder n d) (remainder n d))
(define (floor-remainder n d) (modulo n d))
(define (floor-quotient n d) (quotient (- n (modulo n d)) d))
;; records are vectors tagged with a unique list
(define-syntax define-record-type
  (syntax-rules ()
    ((_ type (ctor cf ...) pred (field acc . mod) ...)
     (begin
       (define type (list 'type))
       (define fields '(field ...))
       (define (ctor cf ...)
         (let ((r (make-vector (+ 1 (length fields)) #f)))
           (vector-set! r 0 type)
           (vector-set! r (record-field-index 'cf fields) cf) ...
           r))
       (define (pred x)
         (and (vector? x) (> (vector-length x) 0) (eq? (vector-ref x 0) type)))
       (define-record-field (record-field-index 'field fields) acc . mod) ...))))
(define (record-field-index f fields)
  (let loop ((fs fields) (i 1)) (if (eq? (car fs) f) i (loop (cdr fs) (+ i 1)))))
(define-syntax define-record-field
  (syntax-rules ()
    ((_ i acc) (define acc (let ((j i)) (lambda (x) (vector-ref x j)))))
    ((_ i acc mod)
     (begin (define acc (let ((j i)) (lambda (x) (vector-ref x j))))
            (define mod (let ((j i)) (lambda (x v) (vector-set! x j v))))))))
