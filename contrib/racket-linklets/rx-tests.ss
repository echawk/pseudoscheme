;;; Racket's own regexp tests (pkgs/racket-test-core/tests/racket/rx.rktl:
;;; its test-regexp cases and its PCRE table, extracted by extract-rx-tests.py
;;; into rx-cases.ss and pcre-table.ss), on Racket's schemified regexp
;;; linklet (run.sh)
(define regexp-match |1/regexp-match|)
(define byte-pregexp |1/byte-pregexp|)
(define pregexp |1/pregexp|)
(define passed 0)
(define failed '())
(define (test expected f . args)
  (let ([got (guard (c [#t (list 'error (if (message-condition? c) (condition-message c) c))])
               (apply f args))])
    (if (equal? got expected)
        (set! passed (+ passed 1))
        (set! failed (cons (list expected got args) failed)))))
(define-syntax err/rt-test
  (syntax-rules ()
    [(_ e) (if (guard (c [#t #t]) e #f)
               (set! passed (+ passed 1))
               (set! failed (cons (list 'error 'e) failed)))]))
(define (test-regexp result pattern input)
  (test result regexp-match pattern input)
  (test result regexp-match (bytes-append (bytes 40 63 58) pattern (bytes 41)) input)
  (test (and result (cons (car result) result))
        regexp-match (bytes-append (bytes 40 63 58 40) pattern (bytes 41 41)) input)
  (test result regexp-match (bytes-append (bytes 40 63 60 61 41) pattern) input)
  (test result regexp-match (bytes-append pattern (bytes 40 63 61 41)) input)
  (test result regexp-match (bytes-append (bytes 40 63 62) pattern (bytes 41)) input))
(define (test-regexp-x result pattern input)
  (test-regexp result pattern input)
  (test-regexp result pattern (bytes-append (bytes 120 120 120) input (bytes 120 120 120))))
(load "rx-cases.ss")
(printf "test-regexp cases: ~a passed, ~a failed\n" passed (length failed))
(define p0 passed) (define f0 (length failed))
(load "pcre-table.ss")
(define x10 (make-bytevector 10 120))
(for-each
  (lambda (t)
    (if (pair? t)
        (begin
          (test (caddr t) regexp-match (byte-pregexp (car t)) (cadr t))
          (test (caddr t) regexp-match (byte-pregexp (car t)) (bytes-append x10 (cadr t)) 10)
          (test (caddr t) regexp-match (byte-pregexp (car t)) (bytes-append (cadr t) x10) 0 (bytevector-length (cadr t)))
          (test (caddr t) regexp-match (byte-pregexp (car t)) (open-bytevector-input-port (cadr t)))
          (test (and (caddr t) (map (lambda (v) (and v (bytes->string/latin-1 v))) (caddr t)))
                regexp-match (pregexp (bytes->string/latin-1 (car t))) (bytes->string/latin-1 (cadr t))))
        (begin
          (err/rt-test (byte-pregexp t))
          (err/rt-test (pregexp (bytes->string/latin-1 t))))))
  pcre-table)
(printf "PCRE table: ~a passed, ~a failed\n" (- passed p0) (- (length failed) f0))
(for-each (lambda (f) (printf "FAIL ~s\n" f)) (list-head (reverse failed) (min 25 (length failed))))
