          (LET ((.STRING (CAR (THE CONS (SUB-READ-TOKEN #\# PORT)))))
            (LET ((TEMP (STRING->NUMBER .STRING)))
              (IF (TRUEP TEMP)
                  TEMP
                  (READING-ERROR PORT "unsupported number syntax" .STRING))))))
    (MAPC #'(LAMBDA (C) (DEFINE-SHARP-MACRO C #'NUMBER-SHARP-MACRO))
          '(#\b #\o #\d #\x #\i #\e))))
(DEFUN SUB-READ-TOKEN (C PORT)
  (PROG (.L.0 .N.1)
    (PSETQ .L.0 (LIST C) .N.1 1)
    (GO LOOP)
    LOOP
    (LET ((L .L.0) (N .N.1))
      (LET ((P (.PEEK-CHAR PORT)))
        (IF (OR (EQ P EOF-OBJECT) (TRUEP (TERMINATING? P)))
            (RETURN (LIST (REVERSE-LIST->STRING L N)))
            (LET ((.C.2 (.READ-CHAR PORT)))
              (PSETQ .L.0 (CONS .C.2 L) .N.1 (+ N 1))
              (GO LOOP)))))))
(SET-VALUE-FROM-FUNCTION 'SUB-READ-TOKEN 'SCHEME::SUB-READ-TOKEN)
(DEFUN PARSE-TOKEN (TOKEN PORT)
  (DECLARE (SPECIAL DOT STRANGE-SYMBOL-NAMES))
  (LET ((.STRING (CAR (THE CONS TOKEN))))
    (IF (LET ((C (CHAR (THE SIMPLE-STRING .STRING) 0)))
          (OR (CHAR-NUMERIC-P C) (CHAR= C #\+) (CHAR= C #\-) (CHAR= C #\.)))
        (LET ((TEMP (STRING->NUMBER .STRING)))
          (IF (TRUEP TEMP)
              TEMP
              (IF (MEMBER .STRING STRANGE-SYMBOL-NAMES :TEST #'SCHEME-EQUAL-P)
                  (INTERN-TOKEN .STRING)
                  (IF (STRING= .STRING ".")
                      DOT
                      (IF (CHAR-NUMERIC-P (CHAR (THE SIMPLE-STRING .STRING) 0))
                          (READING-ERROR
                           PORT
                           "unsupported number syntax"
                           .STRING)
                          (INTERN-TOKEN .STRING))))))
        (INTERN-TOKEN .STRING))))
(SET-VALUE-FROM-FUNCTION 'PARSE-TOKEN 'SCHEME::PARSE-TOKEN)
(LOCALLY
  (DECLARE (SPECIAL STRANGE-SYMBOL-NAMES))
  (SETQ STRANGE-SYMBOL-NAMES '("+" "-" "..." "1+" "-1+")))
(SET-FUNCTION-FROM-VALUE 'STRANGE-SYMBOL-NAMES 'SCHEME::STRANGE-SYMBOL-NAMES)
(DEFUN INTERN-TOKEN (.STRING)
  (INTERN-SCHEME-SYMBOL (IF *FOLD-CASE* (STRING-DOWNCASE .STRING) .STRING)))
(SET-VALUE-FROM-FUNCTION 'INTERN-TOKEN 'SCHEME::INTERN-TOKEN)
(DEFUN READING-ERROR (PORT MESSAGE &REST IRRITANTS)
  (MAYBE-FIX-&REST-PARAMETER IRRITANTS)
  (APPLY #'SCHEME-READING-ERROR PORT MESSAGE IRRITANTS))
(SET-VALUE-FROM-FUNCTION 'READING-ERROR 'SCHEME::READING-ERROR)
(LOCALLY (DECLARE (SPECIAL SCHEME-READ)) (SETQ *SCHEME-READ* SCHEME-READ))
(DEFUN SHARP-NUMERIC-VECTOR (C PORT)
  (SHARP-NUMERIC-VECTOR-AFTER
   (.STRING (CHAR-DOWNCASE (.READ-CHAR PORT)))
   C
   PORT))
(SET-VALUE-FROM-FUNCTION 'SHARP-NUMERIC-VECTOR 'SCHEME::SHARP-NUMERIC-VECTOR)
(DEFUN SHARP-NUMERIC-VECTOR-AFTER (LETTER C PORT)
  (PROG (.DIGITS.0)
    (SETQ .DIGITS.0 'NIL)
    (GO LOOP)
    LOOP
    (LET ((DIGITS .DIGITS.0))
      (LET ((D (.PEEK-CHAR PORT)))
        (IF (AND (CHARACTERP D) (CHAR-NUMERIC-P D))
            (PROGN (SETQ .DIGITS.0 (CONS (.READ-CHAR PORT) DIGITS)) (GO LOOP))
            (LET ((TAG (STRING-APPEND
                        LETTER
                        (COERCE (THE LIST (REVERSE DIGITS)) 'SIMPLE-STRING))))
              (IF (NOT (EQL (.READ-CHAR PORT) #\())
                  (READING-ERROR PORT "bad homogeneous vector syntax" TAG))
              (IF (STRING= TAG "u8")
                  (RETURN (LIST->BYTEVECTOR (SUB-READ-LIST C PORT)))
                  (RETURN (LIST->NUMERIC-VECTOR TAG (SUB-READ-LIST C PORT))))))))))
(SET-VALUE-FROM-FUNCTION
 'SHARP-NUMERIC-VECTOR-AFTER
 'SCHEME::SHARP-NUMERIC-VECTOR-AFTER)
(LOCALLY
  (DECLARE (SPECIAL SHARP-NUMERIC-VECTOR))
  (DEFINE-SHARP-MACRO #\u SHARP-NUMERIC-VECTOR))
(LOCALLY
  (DECLARE (SPECIAL SHARP-NUMERIC-VECTOR))
  (DEFINE-SHARP-MACRO #\s SHARP-NUMERIC-VECTOR))
(LOCALLY
  (DECLARE (SPECIAL SHARP-NUMERIC-VECTOR))
  (DEFINE-SHARP-MACRO #\c SHARP-NUMERIC-VECTOR))
(AT-TOP-LEVEL
  (DEFINE-SHARP-MACRO
   #\v
   #'(LAMBDA (C PORT)
       (.READ-CHAR PORT)
       (IF (NOT (AND (EQL (.READ-CHAR PORT) #\u)
                     (EQL (.READ-CHAR PORT) #\8)
                     (EQL (.READ-CHAR PORT) #\()))
           (READING-ERROR PORT "bad #vu8 syntax"))
       (LIST->BYTEVECTOR (SUB-READ-LIST C PORT)))))
(AT-TOP-LEVEL
  (DEFINE-SHARP-MACRO
   #\'
   #'(LAMBDA (C PORT)
       C
       (.READ-CHAR PORT)
       (LIST 'SCHEME::SYNTAX (SUB-READ-CAREFULLY PORT)))))
(AT-TOP-LEVEL
  (DEFINE-SHARP-MACRO
   #\`
   #'(LAMBDA (C PORT)
       C
       (.READ-CHAR PORT)
       (LIST 'SCHEME::QUASISYNTAX (SUB-READ-CAREFULLY PORT)))))
(AT-TOP-LEVEL
  (DEFINE-SHARP-MACRO
   #\,
   #'(LAMBDA (C PORT)
       C
       (.READ-CHAR PORT)
       (IF (EQL (.PEEK-CHAR PORT) #\@)
           (PROGN
             (.READ-CHAR PORT)
             (LIST 'SCHEME::UNSYNTAX-SPLICING (SUB-READ-CAREFULLY PORT)))
           (LIST 'SCHEME::UNSYNTAX (SUB-READ-CAREFULLY PORT))))))
