;;; SRFI 261: Portable SRFI library reference.  The names are the
;;; library system's (src/r7rs/front.lisp, srfi-alias-form): (srfi
;;; srfi-n) is (srfi n), as are SRFI 97's (srfi :n) and (srfi :n name).
;;; This library exports nothing.
(define-library (srfi 261)
  (export)
  (import (scheme base)))
