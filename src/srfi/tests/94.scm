;;; Tests for SRFI 94, from the examples and specifications in the SRFI
;;; document.
(import (except (scheme base) quotient remainder modulo abs)
        (except (scheme complex) make-rectangular make-polar)
        (scheme inexact)
        (scheme process-context) (srfi 64) (srfi 94))
(test-begin "srfi-94")

(define make-rectangular* (lambda (a b) (+ a (* b (sqrt -1)))))
(define (approx= a b) (< (magnitude (- a b)) 1e-12))

;; quotient, remainder, modulo: exact integers only
(test-eqv 1 (modulo 13 4))
(test-eqv 1 (remainder 13 4))
(test-eqv 3 (modulo -13 4))
(test-eqv -1 (remainder -13 4))
(test-eqv -3 (modulo 13 -4))
(test-eqv 1 (remainder 13 -4))
(test-eqv -1 (modulo -13 -4))
(test-eqv -1 (remainder -13 -4))
(test-eqv 3 (quotient 13 4))
(test-error (remainder -13 -4.0))
(test-error (quotient 2/3 1/5))
(test-error (modulo 13.0 4))

;; quo, rem, mod: reals
(test-eqv 3 (quo 2/3 1/5))
(test-eqv 1/15 (mod 2/3 1/5))
(test-eqv 3.0 (quo .666 1/5))
(test-assert (approx= 65.99999999999995e-3 (mod .666 1/5)))
(test-eqv -1 (rem -13 4))
(test-eqv 3 (mod -13 4))
(test-assert (= -13 (+ (* 4 (quo -13 4)) (rem -13 4))))

;; integer functions
(test-eqv 125 (integer-expt 5 3))
(test-eqv 1 (integer-expt 0 0))
(test-eqv 0 (integer-expt 0 5))
(test-eqv -1 (integer-expt -1 -3))
(test-error (integer-expt 5 -3))
(test-error (integer-expt 2.0 3))
(test-eqv 4 (integer-sqrt 17))
(test-eqv 0 (integer-sqrt 0))
(test-eqv 1000000000000 (integer-sqrt (* 1000000000000 1000000000000)))
(test-eqv 999999999999 (integer-sqrt (- (* 1000000000000 1000000000000) 1)))
(test-error (integer-sqrt -1))
(test-error (integer-sqrt 4.0))
(test-eqv 3 (integer-log 2 8))
(test-eqv 3 (integer-log 2 15))
(test-eqv 4 (integer-log 2 16))
(test-eqv 0 (integer-log 10 9))
(test-eqv 100 (integer-log 10 (expt 10 100)))
(test-error (integer-log 1 8))
(test-error (integer-log 2 0))

;; real functions
(test-eqv 2 (real-sqrt 4))
(test-error (real-sqrt -1))
(test-assert (approx= 1.0 (real-exp 0)))
(test-assert (approx= 1.0 (real-ln (exp 1))))
(test-error (real-ln -1))
(test-assert (approx= 3.0 (real-log 2 8)))
(test-error (real-log 2 -8))
(test-assert (approx= 0.0 (real-sin 0)))
(test-assert (approx= 1.0 (real-cos 0)))
(test-assert (approx= 0.0 (real-tan 0)))
(test-assert (approx= (/ (acos -1) 2) (real-asin 1)))
(test-error (real-asin 2))
(test-error (real-acos -1.5))
(test-assert (approx= (/ (acos -1) 4) (real-atan 1)))
(test-assert (approx= (/ (acos -1) 4) (real-atan 1 1)))
(test-error (real-sin (make-rectangular* 1 1)))
(test-eqv 8 (real-expt 2 3))
(test-eqv -8 (real-expt -2 3))
(test-assert (approx= 1.4142135623730951 (real-expt 2.0 0.5)))
(test-error (real-expt -2 1/2))
(test-error (real-expt -2.0 0.5))
(test-assert (approx= 1.0 (ln (exp 1))))

;; restricted to reals
(test-eqv 7 (abs -7))
(test-error (abs (make-rectangular* 3 4)))
(test-assert (approx= (make-rectangular* 1 2) (make-rectangular 1 2)))
(test-error (make-rectangular (make-rectangular* 1 1) 2))
(test-assert (approx= -1 (make-polar 1 (acos -1))))
(test-error (make-polar 1 (make-rectangular* 1 1)))

(let ((failures (test-runner-fail-count (test-runner-current))))
  (test-end "srfi-94")
  (exit (if (zero? failures) 0 1)))
