;;; Tests for SRFI 70, from the examples in the SRFI document.  SRFI 70
;;; writes a NaN as 0/0; those examples test nan? instead.
(import (except (scheme base) gcd lcm expt)
        (only (scheme inexact) nan?)
        (scheme process-context) (srfi 64) (srfi 70))
(test-begin "srfi-70")

(test-equal #t (positive? +inf.0))
(test-equal #t (negative? -inf.0))
(test-equal #f (finite? -inf.0))
(test-equal #t (infinite? +inf.0))
(test-eqv 4 (max 3 4))
(test-eqv 4.0 (max 3.9 4))
(test-eqv +inf.0 (max +inf.0 7))
(test-eqv -inf.0 (min -inf.0 7))
(test-eqv +inf.0 (+ +inf.0 +inf.0))
(test-assert (nan? (+ +inf.0 -inf.0)))
(test-eqv +inf.0 (* 5 +inf.0))
(test-eqv -inf.0 (* -5 +inf.0))
(test-eqv -inf.0 (* +inf.0 -inf.0))
(test-eqv -6 (- 3 4 5))
(test-assert (nan? (- +inf.0 +inf.0)))
(test-eqv 3/20 (/ 3 4 5))
(test-eqv +inf.0 (/ 0.0))
(test-eqv +inf.0 (/ 1.0 0))
(test-eqv -inf.0 (/ -1 0.0))
(test-eqv 0.0 (/ +inf.0))
(test-assert (nan? (/ 0 0.0)))
(test-assert (nan? (/ 0.0 0.0)))
(test-eqv +inf.0 (abs -inf.0))
(test-eqv 1 (modulo 13 4))
(test-eqv -1 (remainder -13 4))
(test-eqv -3 (modulo 13 -4))
(test-eqv -1 (modulo -13 -4))
(test-eqv -1.0 (remainder -13 -4.0))
(test-eqv 3 (quotient 2/3 1/5))
(test-eqv 1/15 (modulo 2/3 1/5))
(test-assert (= 3 (quotient .666 1/5)))
(test-assert (< (abs (- (modulo .666 1/5) 0.066)) 1e-9))
(test-eqv 4 (gcd 32 -36))
(test-eqv 0 (gcd))
(test-eqv 288 (lcm 32 -36))
(test-eqv 1 (lcm))
(test-eqv 1/12 (gcd 1/6 1/4))
(test-eqv 1/2 (lcm 1/6 1/4))
(test-eqv 1/12 (gcd 1/6 5/4))
(test-eqv 5/2 (lcm 1/6 5/4))
(test-eqv 1/2 (gcd -1/2))
(test-eqv 1/2 (lcm -1/2 1/4))
(test-eqv 3 (numerator (/ 6 4)))
(test-eqv 2.0 (denominator (exact->inexact (/ 6 4))))
(test-eqv 4.0 (round 3.5))
(test-eqv 4 (round 7/2))
(test-eqv -5 (exact-floor -4.3))
(test-eqv -4 (exact-ceiling -4.3))
(test-eqv -4 (exact-truncate -4.3))
(test-eqv 4 (exact-round 3.5))
(test-eqv 4 (exact-round 4.5))
(test-assert (exact? (exact-round 3.7)))
(test-eqv 1/3 (rationalize (inexact->exact .3) 1/10))
(test-eqv +inf.0 (exp +inf.0))
(test-eqv 0.0 (exp -inf.0))
(test-eqv +inf.0 (log +inf.0))
(test-eqv -inf.0 (log 0.0))
(test-assert (< (abs (- (atan +inf.0) 1.5707963267948965)) 1e-15))
(test-assert (< (abs (- (atan -inf.0) -1.5707963267948965)) 1e-15))
(test-eqv +inf.0 (sqrt +inf.0))
(test-assert (< (magnitude (- (sqrt -5) (make-rectangular 0 2.23606797749979))) 1e-12))
(test-eqv 125 (expt 5 3))
(test-eqv 1/125 (expt 5 -3))
(test-eqv 1 (expt 5 0))
(test-eqv 0 (expt 0 5))
(test-eqv 1 (expt 0 0))
(test-eqv 0.0 (expt 0 (make-rectangular 5 .0000312)))
(test-eqv +inf.0 (expt 0 -5))
(test-eqv +inf.0 (expt 0 (make-rectangular -5 .0000312)))
(test-eqv 1.0 (expt 0 0.0))
(test-eqv +inf.0 (expt 5 +inf.0))
(test-eqv 0.0 (expt 5 -inf.0))
(test-eqv 0.0 (angle +inf.0))
(test-eqv 3.141592653589793 (angle -inf.0))
(test-eqv 0.5 (exact->inexact 1/2))
(test-eqv 0.5 (exact->inexact 0.5))
(test-eqv 1/2 (inexact->exact 0.5))
(test-eqv 1/2 (inexact->exact 1/2))
(test-eqv +inf.0 (string->number "+inf.0"))
(test-equal "-inf.0" (number->string -inf.0))

(let ((failures (test-runner-fail-count (test-runner-current))))
  (test-end "srfi-70")
  (exit (if (zero? failures) 0 1)))
