  (let ((fd (sb-posix:open path flags mode)))
    (fd-port fd (cond ((logtest flags sb-posix:o-rdwr) "rw")
		      ((logtest flags sb-posix:o-wronly) "w")
		      (t "r")))))
(defguile "close-fdes" (fd) (sb-posix:close fd) *unspecified*)
