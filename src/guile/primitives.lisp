;;; (ice-9 i18n): the C locale only

(defun string-compare-fn (test &optional fold)
  (lambda (a b &optional locale)
    (declare (ignore locale))
    (bool (funcall test (if fold (string-downcase a) a) (if fold (string-downcase b) b)))))

(defun char-compare-fn (test &optional fold)
  (lambda (a b &optional locale)
    (declare (ignore locale))
    (bool (funcall test (if fold (char-downcase a) a) (if fold (char-downcase b) b)))))

(defstruct (locale (:constructor make-locale* ())) )
(defmethod print-object ((l locale) stream) (write-string "#<locale C>" stream))
(defvar *c-locale* (make-locale*))

(defextension "scm_init_i18n"
  (append
   (list
    (cons "make-locale" (lambda (&rest args) (declare (ignore args)) *c-locale*))
    (cons "locale?" (lambda (x) (bool (locale-p x))))
    (cons "%global-locale" *c-locale*)
    (cons "string-locale<?" (string-compare-fn #'string<))
    (cons "string-locale>?" (string-compare-fn #'string>))
    (cons "string-locale-ci<?" (string-compare-fn #'string< t))
    (cons "string-locale-ci>?" (string-compare-fn #'string> t))
    (cons "string-locale-ci=?" (string-compare-fn #'string= t))
    (cons "char-locale<?" (char-compare-fn #'char<))
    (cons "char-locale>?" (char-compare-fn #'char>))
    (cons "char-locale-ci<?" (char-compare-fn #'char< t))
    (cons "char-locale-ci>?" (char-compare-fn #'char> t))
    (cons "char-locale-ci=?" (char-compare-fn #'char= t))
    (cons "char-locale-downcase" (lambda (c &optional l) (declare (ignore l)) (char-downcase c)))
    (cons "char-locale-upcase" (lambda (c &optional l) (declare (ignore l)) (char-upcase c)))
    (cons "char-locale-titlecase" (lambda (c &optional l) (declare (ignore l)) (char-upcase c)))
    (cons "string-locale-downcase" (lambda (s &optional l) (declare (ignore l)) (string-downcase s)))
    (cons "string-locale-upcase" (lambda (s &optional l) (declare (ignore l)) (string-upcase s)))
    (cons "string-locale-titlecase" (lambda (s &optional l) (declare (ignore l)) (string-capitalize s)))
    (cons "locale-string->integer"
	  (lambda (s &optional (base 10) l)
	    (declare (ignore l))
	    (multiple-value-bind (n end) (parse-integer s :radix base :junk-allowed t)
	      (if n (values n end) (values ps:false 0)))))
    (cons "locale-string->inexact"
	  (lambda (s &optional l)
	    (declare (ignore l))
	    (let ((n (ps:parse-scheme-number s 10)))
	      (if n (values (float n 1d0) (length s)) (values ps:false 0)))))
    (cons "locale-encoding" (lambda (&optional l) (declare (ignore l)) "UTF-8"))
    (cons "locale-decimal-point" (lambda (&optional l) (declare (ignore l)) "."))
    (cons "locale-thousands-separator" (lambda (&optional l) (declare (ignore l)) ""))
    (cons "locale-digit-grouping" (lambda (&optional l) (declare (ignore l)) '()))
    (cons "locale-am-string" (lambda (&optional l) (declare (ignore l)) "AM"))
    (cons "locale-pm-string" (lambda (&optional l) (declare (ignore l)) "PM"))
    (cons "locale-yes-regexp" (lambda (&optional l) (declare (ignore l)) "^[yY]"))
    (cons "locale-no-regexp" (lambda (&optional l) (declare (ignore l)) "^[nN]")))
   (loop for (name names) in '(("locale-day" ("Sunday" "Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday"))
			       ("locale-day-short" ("Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat"))
			       ("locale-month" ("January" "February" "March" "April" "May" "June" "July"
						"August" "September" "October" "November" "December"))
			       ("locale-month-short" ("Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug"
						      "Sep" "Oct" "Nov" "Dec")))
	 collect (let ((names names))
		   (cons name (lambda (n &optional l) (declare (ignore l)) (nth (1- n) names)))))))

