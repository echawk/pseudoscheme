;;;; Write api.c and ids.h from the table (table.lisp, scheme.lisp):
;;;;   sbcl --script gen.lisp OUTPUT-DIRECTORY
;;;; src/libguile/Makefile runs it.  It first writes missing.lisp: every
;;;; function in exports-3.0.11.txt (what GNU Guile 3.0.11's libguile
;;;; exports) that the table doesn't have yet.  The system loads
;;;; table.lisp, scheme.lisp and missing.lisp in the same order, so the
;;;; entries' indexes agree.

(defvar *here* (make-pathname :name nil :type nil :defaults *load-truename*))
(load (merge-pathnames "table.lisp" *here*))
(load (merge-pathnames "scheme.lisp" *here*))
(in-package "PSEUDOSCHEME-LIBGUILE")

(with-open-file (out (merge-pathnames "missing.lisp" cl-user::*here*) :direction :output :if-exists :supersede)
  (format out ";;;; Generated by src/libguile/gen.lisp: don't edit.  The functions~%")
  (format out ";;;; GNU Guile 3.0.11's libguile exports that the table doesn't implement yet.~%~%")
  (format out "(in-package \"PSEUDOSCHEME-LIBGUILE\")~%~%")
  (with-open-file (in (merge-pathnames "exports-3.0.11.txt" cl-user::*here*))
    (loop for name = (read-line in nil) while name
	  unless (find-api name) do (format out "(defmissing ~S)~%" name))))
(load (merge-pathnames "missing.lisp" cl-user::*here*))

(defparameter *c-types*
  '((:scm . "uintptr_t") (:void . "void") (:int . "int") (:uint . "unsigned int")
    (:long . "long") (:ulong . "unsigned long") (:size . "size_t") (:ssize . "ssize_t")
    (:int8 . "int8_t") (:uint8 . "uint8_t") (:int16 . "int16_t") (:uint16 . "uint16_t")
    (:int32 . "int32_t") (:uint32 . "uint32_t") (:int64 . "int64_t") (:uint64 . "uint64_t")
    (:intmax . "intmax_t") (:uintmax . "uintmax_t") (:intptr . "intptr_t")
    (:uintptr . "uintptr_t") (:double . "double") (:char . "char") (:wchar . "int32_t")
    (:bool . "int") (:ptr . "void *") (:string . "const char *")))

(defun c-type (type)
  (or (cdr (assoc type *c-types*)) (error "unknown type ~S" type)))

(defun signed-type-p (type)
  (member type '(:int :long :ssize :int8 :int16 :int32 :int64 :intmax :intptr :char
		 :wchar :bool)))

(defun c-identifier (name)
  (substitute #\_ #\- (string-upcase name)))

(defun widen (type var)
  "C: VAR of TYPE as a uintptr_t."
  (case type
    (:double (format nil "psg_double_bits (~A)" var))
    ((:ptr :string) (format nil "(uintptr_t) ~A" var))
    (t (if (signed-type-p type)
	   (format nil "(uintptr_t) (intptr_t) ~A" var)
	   (format nil "(uintptr_t) ~A" var)))))

(defun narrow (type expr)
  "C: the uintptr_t EXPR as TYPE."
  (case type
    (:double (format nil "psg_bits_double (~A)" expr))
    (t (format nil "(~A) ~A" (c-type type) expr))))

(defun write-stub (api out)
  (let* ((args (api-args api))
	 (vars (loop for i from 0 below (length args) collect (format nil "a~D" i)))
	 (ret (api-return api)))
    (format out "~%~:[~;__attribute__ ((noreturn)) ~]~A~%~A (~:[void~;~:*~{~A~^, ~}~])~%{~%"
	    (api-noreturn api) (c-type ret) (api-name api)
	    (loop for type in args for var in vars
		  collect (format nil "~A ~A" (c-type type) var)))
    (format out "  uintptr_t args[~D];~%" (max 1 (length args)))
    (loop for type in args for var in vars for i from 0
	  do (format out "  args[~D] = ~A;~%" i (widen type var)))
    (cond ((eq (api-kind api) :missing)
	   (format out "  psg_entry_fn (~D, args);~%  abort ();~%" (api-index api)))
	  ((api-noreturn api)
	   (format out "  psg_entry_fn (~D, args);~%  abort ();~%" (api-index api)))
	  ((eq ret :void)
	   (format out "  psg_entry_fn (~D, args);~%" (api-index api)))
	  (t (format out "  return ~A;~%" (narrow ret (format nil "psg_entry_fn (~D, args)" (api-index api))))))
    (format out "}~%")))

(defun write-api (directory)
  (with-open-file (out (merge-pathnames "api.c" directory) :direction :output :if-exists :supersede)
    (format out "/* Generated by src/libguile/gen.lisp from table.lisp and scheme.lisp:
   don't edit.  Each function passes its arguments to the Lisp side.  */

#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <sys/types.h>
#include \"psg.h\"

static inline uintptr_t
psg_double_bits (double d)
{
  uintptr_t u;
  memcpy (&u, &d, sizeof u);
  return u;
}

static inline double
psg_bits_double (uintptr_t u)
{
  double d;
  memcpy (&d, &u, sizeof d);
  return d;
}

/* The table's signature: the Lisp side refuses a library built from
   another table (bridge.lisp).  */
const char psg_table_signature[] = \"~A\";
" (table-signature))
    (loop for api across *api*
	  unless (member (api-kind api) '(:varargs :core))
	    do (write-stub api out)))
  (with-open-file (out (merge-pathnames "ids.h" directory) :direction :output :if-exists :supersede)
    (format out "/* Generated by src/libguile/gen.lisp: the table's ids of the
   functions core.c defines.  */~%")
    (loop for api across *api*
	  when (eq (api-kind api) :varargs)
	    do (format out "#define PSG_ID_~A ~D~%"
		       (c-identifier (subseq (api-name api) (length "scm_"))) (api-index api)))))

(write-api (let ((d (second sb-ext:*posix-argv*)))
	     (pathname (if (char= (char d (1- (length d))) #\/) d (concatenate 'string d "/")))))
