; -*- Mode: Lisp; Syntax: Common-Lisp; Package: CL-USER; -*-

;;;; Regenerating the translator's bootstrap .qso files.
;;;
;;; The translator itself (p-record.scm, alpha.scm, derive.scm, etc.,
;;; listed in translator.files) is written in Scheme and is normally
;;; loaded pre-translated, as the corresponding .qso files -- that's
;;; what lets :quasischeme/translator load without already having a
;;; working Quasischeme.
;;;
;;; Whenever one of those .scm files changes, its .qso file is stale
;;; and must be regenerated by asking the (already-loaded, working)
;;; translator to translate itself again. Load this file after loading
;;; :quasischeme, then call (QUASISCHEME-BOOTSTRAP:REGENERATE-PSO-FILES).
;;;
;;; After regenerating, always reload :quasischeme from a fresh Lisp
;;; image and re-run the test suite (tests/run-r5rs-tests.lisp) before
;;; trusting the new .qso files.

(defpackage :quasischeme-bootstrap
  (:use :common-lisp)
  (:export #:regenerate-pso-files #:regenerate-closed-pso
	   #:regenerate-reader-writer))

(in-package :quasischeme-bootstrap)

(defun src-directory ()
  ;; NB: not ASDF:SYSTEM-RELATIVE-PATHNAME / ASDF:SYSTEM-SOURCE-DIRECTORY
  ;; -- those give the directory of the .asd file itself (the repo
  ;; root), not a system's :PATHNAME. The .scm/.qso files live under
  ;; src/, where :quasischeme's components actually are.
  (asdf:component-pathname (asdf:find-system :quasischeme)))

(defun translator-files ()
  (with-open-file (s (merge-pathnames "translator.files" (src-directory)))
    (read s)))

(defun translator-env ()
  (symbol-value (intern "SCHEME-TRANSLATOR-ENV" "SCHEME-TRANSLATOR")))

(defmacro with-bootstrap-reader (&body body)
  ;; Bootstrap regeneration must always use the CL-reader bridge
  ;; (qs:scheme-read-using-commonlisp-reader), regardless of what
  ;; qs:*scheme-read* currently is -- if :quasischeme/reader has also
  ;; been loaded in this image (e.g. for R5RS work), the dedicated
  ;; Scheme48-derived reader it installs can't resolve the CL
  ;; package-qualified symbols (QS-LISP:SETF and friends) the
  ;; translator's own sources rely on. See README.md.
  ;;
  ;; Also binds *DEFAULT-PATHNAME-DEFAULTS* to src/ (where the .scm/.qso
  ;; files actually live, since quasischeme.asd itself is at the repo
  ;; root) -- QS:TRANSLATE-FILE resolves bare filenames like "ssig"
  ;; against *DEFAULT-PATHNAME-DEFAULTS*, not against the .asd.
  `(let ((qs:*scheme-read* #'qs:scheme-read-using-commonlisp-reader)
	 (*default-pathname-defaults* (src-directory)))
     ,@body))

(defun regenerate-pso-files (&optional (files (translator-files)))
  "Retranslate each named .scm file (default: all of translator.files)
to its .qso file, using the currently-loaded translator. Returns the
list of files regenerated."
  (with-bootstrap-reader
    (let ((env (translator-env)))
      (dolist (file files)
	(format t "~&Regenerating ~A.qso from ~A.scm~%" file file)
	(qs:translate-file file env))))
  files)

(defun regenerate-closed-pso ()
  "CLOSED.PSO isn't translated from a .scm source -- it's synthesized
by WRITE-CLOSED-DEFINITIONS from the *current* builtin integrations
table (see builtin.scm), as real top-level function definitions for
every procedure in REVISED^4-SCHEME-INTERFACE. So it goes stale
whenever builtin.scm's integration table changes (e.g. which CL
function backs a given Scheme procedure, or how its result is
coerced to a Scheme boolean), even though no line of CLOSED.PSO
itself changed. Call this after such a change, then always do a full
REGENERATE-PSO-FILES + fresh-image reload + test run before trusting
the result, same as for the other bootstrap files."
  (with-bootstrap-reader
    (funcall (intern "WRITE-CLOSED-DEFINITIONS" "SCHEME-TRANSLATOR")
	     (symbol-value (intern "REVISED^4-SCHEME-STRUCTURE" "SCHEME-TRANSLATOR"))
	     (merge-pathnames "closed.qso" (src-directory)))))

(defun regenerate-reader-writer ()
  "Retranslate read.scm/write.scm (the dedicated Scheme48-derived
reader/writer, :quasischeme/reader) using the translator, same as
REGENERATE-PSO-FILES does for the translator's own sources. These
target REVISED^4-SCHEME-ENV, not SCHEME-TRANSLATOR-ENV, since they're
ordinary runtime code, not part of the translator itself."
  (with-bootstrap-reader
    (let ((env (symbol-value (intern "REVISED^4-SCHEME-ENV" "SCHEME-TRANSLATOR"))))
      (dolist (file '("read" "write"))
	(format t "~&Regenerating ~A.qso from ~A.scm~%" file file)
	(qs:translate-file file env))))
  '("read" "write"))
