;;; -*- Mode: Scheme -*-
;;;; (pseudoscheme chez extend-syntax): what extend-syntax's
;;;; transformers (src/chez/syntax.scm) call when they run.  A library of
;;;; its own, which (chezscheme) imports (src/chez/chez.lisp), because a
;;;; transformer can't use definitions of the library it is defined in.

(library (pseudoscheme chez extend-syntax)
  (export es-pattern-depths es-check-pattern es-match es-bind
          es-template-symbols es-map es-subst es-wrap)
  (import (rnrs))

  (define (es-pattern-depths p keys)
    (cond ((symbol? p)
           (if (or (memq p keys) (eq? p '...)) '() (list (cons p 0))))
          ((pair? p)
           (if (and (pair? (cdr p)) (eq? (cadr p) '...))
               (map (lambda (d) (cons (car d) (+ (cdr d) 1)))
                    (es-pattern-depths (car p) keys))
               (append (es-pattern-depths (car p) keys)
                       (es-pattern-depths (cdr p) keys))))
          (else '())))

  ;; the pattern's (variable . depth)s; an error if it is not a pattern
  (define (es-check-pattern p keys form)
    (define (bad) (syntax-violation 'extend-syntax "invalid pattern" form p))
    (let check ((p p))
      (cond ((pair? p)
             (when (eq? (car p) '...) (bad))
             (check (car p))
             (let ((d (cdr p)))
               (if (and (pair? d) (eq? (car d) '...))
                   (unless (null? (cdr d)) (bad))
                   (check d))))
            ((eq? p '...) (bad))))
    (let ((vars (map car (es-pattern-depths p keys))))
      (let loop ((vs vars))
        (when (pair? vs)
          (when (memq (car vs) (cdr vs))
            (syntax-violation 'extend-syntax "duplicate pattern variable" form (car vs)))
          (loop (cdr vs))))))

  ;; the environment extending ENV with F's match with P, or #f
  (define (es-match p f keys env)
    (cond ((symbol? p)
           (if (memq p keys)
               (and (eq? f p) env)
               (cons (cons* p 0 f) env)))
          ((pair? p)
           (if (and (pair? (cdr p)) (eq? (cadr p) '...))
               (let loop ((f f) (envs '()))
                 (cond ((pair? f)
                        (let ((e (es-match (car p) (car f) keys '())))
                          (and e (loop (cdr f) (cons e envs)))))
                       ((null? f)
                        (let ((envs (reverse envs)))
                          (append (map (lambda (d)
                                         (cons* (car d) (+ (cdr d) 1)
                                                (map (lambda (e) (cddr (assq (car d) e))) envs)))
                                       (es-pattern-depths (car p) keys))
                                  env)))
                       (else #f)))
               (and (pair? f)
                    (let ((e (es-match (car p) (car f) keys env)))
                      (and e (es-match (cdr p) (cdr f) keys e))))))
          ((null? p) (and (null? f) env))
          (else (and (equal? p f) env))))

  (define (es-bind p v env)
    (or (es-match p v '() env)
        (syntax-violation 'extend-syntax "with: the value doesn't match the pattern" p v)))

  (define (es-template-symbols t acc)
    (cond ((symbol? t) (cons t acc))
          ((pair? t) (es-template-symbols (car t) (es-template-symbols (cdr t) acc)))
          ((vector? t) (es-template-symbols (vector->list t) acc))
          (else acc)))

  ;; the list of (PROC env) for each iteration over the variables of
  ;; SUB that have ellipsis depth in ENV
  (define (es-map sub env proc)
    (let ((entries
           (let loop ((syms (es-template-symbols sub '())) (acc '()))
             (if (null? syms)
                 acc
                 (let ((b (assq (car syms) env)))
                   (loop (cdr syms)
                         (if (and b (> (cadr b) 0) (not (memq b acc))) (cons b acc) acc)))))))
      (when (null? entries)
        (syntax-violation 'extend-syntax "no pattern variable to repeat in the template" sub))
      (let ((n (length (cddr (car entries)))))
        (for-each (lambda (b)
                    (unless (= (length (cddr b)) n)
                      (syntax-violation 'extend-syntax "pattern variables of different lengths" sub)))
                  entries)
        (let loop ((i 0) (acc '()))
          (if (= i n)
              (reverse acc)
              (loop (+ i 1)
                    (cons (proc (append (map (lambda (b)
                                               (cons* (car b) (- (cadr b) 1) (list-ref (cddr b) i)))
                                             entries)
                                        env))
                          acc)))))))

  (define (es-subst t env)
    (cond ((symbol? t)
           (let ((b (assq t env)))
             (cond ((not b) t)
                   ((eqv? (cadr b) 0) (cddr b))
                   (else (syntax-violation 'extend-syntax "pattern variable used without its ellipsis" t)))))
          ((pair? t)
           (if (and (pair? (cdr t)) (eq? (cadr t) '...))
               (append (es-map (car t) env (lambda (e) (es-subst (car t) e)))
                       (es-subst (cddr t) env))
               (cons (es-subst (car t) env) (es-subst (cdr t) env))))
          ((vector? t) (list->vector (es-subst (vector->list t) env)))
          (else t)))

  ;; the form made from DATUM, in the context of the use's keyword
  (define (es-wrap x datum)
    (syntax-case x ()
      ((kw . _) (datum->syntax #'kw datum)))))
